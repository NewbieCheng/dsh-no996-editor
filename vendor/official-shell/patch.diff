+/**
+ * Composer footer: how full this conversation's context window is (ACP usage_update).
+ * Always shown (empty ring before the first usage report). Click opens used/size.
+ * Breakdown of system/tools/messages is not available from the bridge yet.
+ */
+import React from 'react';
+import { useT } from '@/i18n';
+import { useClickOpen } from 'openfilm/studio-ui/lib/click-open.ts';
+import { Popover } from './Popover';
+import { POPOVER_CHROME } from './ComposerCard';
+
+const SIZE = 16;
+const STROKE = 2;
+const R = (SIZE - STROKE) / 2;
+const C = 2 * Math.PI * R;
+const CX = SIZE / 2;
+const CY = SIZE / 2;
+
+function formatTokens(n: number): string {
+  if (!Number.isFinite(n) || n < 0) return '—';
+  if (n >= 1_000_000) return `~${(n / 1_000_000).toFixed(1)}M`;
+  if (n >= 10_000) return `~${Math.round(n / 1000)}K`;
+  if (n >= 1000) return `~${(n / 1000).toFixed(1)}K`;
+  return String(Math.round(n));
+}
+
+export function ContextUsage({ used, size }: { used: number; size: number }) {
+  const t = useT();
+  const popup = useClickOpen();
+  const known = size > 0;
+  const share = known ? Math.min(1, Math.max(0, used / size)) : 0;
+  const pct = Math.round(share * 100);
+  const nearlyFull = known && share >= 0.85;
+  const hasUsage = known && used > 0;
+  const visualShare = hasUsage ? Math.max(share, 0.02) : 0;
+  const dash = `${(visualShare * C).toFixed(2)} ${C.toFixed(2)}`;
+  const stroke = nearlyFull ? 'var(--accent)' : 'var(--text-muted)';
+  const pctLabel = hasUsage && pct === 0 ? '<1' : String(pct);
+  const label = t('composer.contextUsed').replace('{pct}', pctLabel);
+
+  return (
+    <Popover
+      open={popup.open}
+      onOpenChange={popup.setOpen}
+      placement="top"
+      align="end"
+      bare
+      trigger={(
+        <button
+          type="button"
+          className="openfilm-composer-tool"
+          aria-label={label}
+          aria-expanded={popup.open}
+          aria-haspopup="dialog"
+        >
+          {/* Rotate progress in SVG space — CSS rotate on <svg> skewed hit-testing. */}
+          <span className="inline-flex h-4 w-4 items-center justify-center" aria-hidden>
+            <svg width={SIZE} height={SIZE} viewBox={`0 0 ${SIZE} ${SIZE}`} className="block">
+              <circle cx={CX} cy={CY} r={R} fill="none" stroke="var(--border)" strokeWidth={STROKE} />
+              {hasUsage && (
+                <circle
+                  cx={CX}
+                  cy={CY}
+                  r={R}
+                  fill="none"
+                  stroke={stroke}
+                  strokeWidth={STROKE}
+                  strokeLinecap="round"
+                  strokeDasharray={dash}
+                  transform={`rotate(-90 ${CX} ${CY})`}
+                />
+              )}
+            </svg>
+          </span>
+        </button>
+      )}
+    >
+      <div
+        role="dialog"
+        aria-label={label}
+        className="w-[240px] rounded-[10px] border border-[var(--border)] bg-[var(--bg-topbar-popover)] p-3 shadow-[0_12px_40px_-12px_rgba(0,0,0,0.45)]"
+        style={POPOVER_CHROME}
+      >
+        <div className="flex items-baseline justify-between gap-3">
+          <span className="text-[12.5px] font-medium text-[var(--text)]">
+            {label}
+          </span>
+          <span className="shrink-0 tabular-nums text-[11.5px] text-[var(--text-faint)]">
+            {known ? `${formatTokens(used)} / ${formatTokens(size)}` : '—'}
+          </span>
+        </div>
+        <div className="mt-2.5 h-1.5 overflow-hidden rounded-full bg-[var(--bg-field)]" aria-hidden>
+          <div
+            className="h-full rounded-full transition-[width] duration-200"
+            style={{ width: `${hasUsage ? Math.max(pct, 1) : 0}%`, background: stroke }}
+          />
+        </div>
+        <p className="mt-2 text-[11px] leading-relaxed text-[var(--text-faint)]">
+          {known ? t('composer.contextHint') : t('composer.contextEmpty')}
+        </p>
+      </div>
+    </Popover>
+  );
+}
