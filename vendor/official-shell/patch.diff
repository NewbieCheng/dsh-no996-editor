+      const checkAsr = wanted === 'asr' || wanted === 'both';
+      const checkTools = wanted === 'tools' || wanted === 'both' || wanted === 'path-fix';
+
+      if (checkTools && !badTools.length && (!checkAsr || !asrBad)) {
+        setShowChoices(false);
+        setShowGuide(false);
+        setStatus(checkAsr
+          ? '检查通过：视频工具与转写模型均可用。请回到原操作重试。'
+          : '检查通过：ffmpeg 和 ffprobe 均可用。请回到原操作重试。');
+        return;
+      }
+
+      const nextIssues: string[] = [];
+      if (checkTools) nextIssues.push(...badTools.map(name => `${name}：${LABELS[tools![name].status as Status]}`));
+      if (checkAsr && asrBad) {
+        nextIssues.push(asr?.error
+          ? `转写模型：${asr.error.slice(0, 120)}`
+          : (asr?.installing ? '转写模型：正在下载' : '转写模型：未安装'));
+      }
+      setIssues(nextIssues);
+      setShowChoices(true);
+      setShowGuide(checkTools && badTools.length > 0);
+      if (platform) setGuide(INSTRUCTIONS[platform] + ' 安装后请确认工具可用，再返回此处重新检查。');
+      setStatus('本机依赖需要注意：' + nextIssues.join('；') + '。可复制兜底提示词到 DSH 主会话（完全访问）。');
+      if (wanted === 'tools' && asrBad) setKind('both');
+      else if (wanted === 'asr' && badTools.length) setKind('both');
+      else setKind(wanted === 'path-fix' ? 'path-fix' : wanted);
+    } catch {
+      if (current !== generation.current) return;
+      setBusy(false);
+      setShowChoices(true);
+      setShowGuide(false);
+      setIssues([]);
+      setStatus('环境检查暂时失败。仍可复制兜底提示词到 DSH 主会话；或重载插件后再检查。');
+    }
+  }, []);
