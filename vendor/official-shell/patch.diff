+const fill = (template: string, values: Record<string, string | number>) =>
+  template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''));
+
+async function hostRpc<T>(channel: string, payload: Record<string, unknown> = {}): Promise<T> {
+  const response = await fetch('/__dsh/official-rpc', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ channel, payload }),
+  });
+  if (!response.ok) {
+    let detail = '';
+    try { detail = (await response.text()).slice(0, 200); } catch { /* ignore */ }
+    throw new Error(detail || `HTTP ${response.status}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+function labelOf(status: AuthStatus | null, t: (path: string) => string): string {
+  if (!status?.loggedIn) return '';
+  if (status.dev) return t('workbench.labelDev');
+  if (status.guest) return t('workbench.labelGuest');
+  return String(status.displayName || status.account || t('workbench.labelSignedIn')).trim().slice(0, 64);
+}
+
+/** Settings and the project browser display the same identity used by the top bar, not a provider login. */
+export function WorkbenchAccountSummary({ surface }: { surface: 'settings' | 'projects' }) {
+  const t = useT();
+  const language = useLanguage();
+  const [status, setStatus] = React.useState<AuthStatus | null>(null);
+  React.useEffect(() => {
+    let live = true;
+    let sequence = 0;
+    const refresh = () => {
+      const current = ++sequence;
+      void hostRpc<AuthStatus>('auth:status').then((next) => { if (live && current === sequence) setStatus(next); },
+        () => { if (live && current === sequence) setStatus(null); });
+    };
+    refresh();
+    window.addEventListener('no996-auth-changed', refresh);
+    return () => { live = false; window.removeEventListener('no996-auth-changed', refresh); };
+  }, []);
+  const product = language === 'zh-CN' ? PRODUCT_NAME_ZH : PRODUCT_NAME;
+  return (
+    <div data-no996-account={surface} className="flex min-w-0 flex-col gap-1">
+      <strong className="truncate text-[13px]">{product}</strong>
+      {status ? <span className="truncate text-[12px] text-[var(--text-muted)]">{labelOf(status, t) || t('projects.accountLocal')}</span> : null}
+    </div>
+  );
+}
+
+function localeTag(language: string): string {
+  if (language === 'zh-CN') return 'zh-CN';
+  if (language === 'ja') return 'ja';
+  if (language === 'ko') return 'ko';
+  if (language === 'es') return 'es';
+  return 'en';
+}
+
+function formatPoints(value: number | null | undefined, language: string): string {
+  if (typeof value === 'number' && Number.isFinite(value)) {
+    return new Intl.NumberFormat(localeTag(language)).format(value);
+  }
+  return '—';
+}
+
+function formatSyncedAt(iso: string | undefined, language: string): string {
+  if (!iso) return '';
+  const ms = Date.parse(iso);
+  if (!Number.isFinite(ms)) return '';
+  try {
+    return new Date(ms).toLocaleString(localeTag(language), { hour12: false, month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
+  } catch {
+    return '';
+  }
+}
