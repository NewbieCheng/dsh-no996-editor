+    const every = window.setInterval(probe, 5000);
+    return () => {
+      cancelled = true;
+      inFlight?.abort();
+      clearTimeout(first);
+      clearInterval(every);
+      clearTimeout(unlockTimer);
+    };
+  }, []);
+
+  return null;
+}
