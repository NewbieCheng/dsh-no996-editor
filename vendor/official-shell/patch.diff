+                    <p className="py-8 text-center text-[12px] text-[var(--text-muted)]">{t('workbench.ledgerLoading')}</p>
+                  ) : (ledgerData.items?.length ?? 0) === 0 ? (
+                    <p className="py-8 text-center text-[12px] text-[var(--text-muted)]">{t('workbench.ledgerEmpty')}</p>
+                  ) : (
+                    <div className="divide-y divide-[var(--border)] rounded-md border border-[var(--border)]">
+                      {ledgerData.items!.map((item, idx) => {
+                        const cost = Number(item.charged_points ?? item.points_cost ?? item.delta ?? 0);
+                        const modelLabel = item.resolved_model || item.model_code || item.model || item.service_code || item.reason || t('workbench.platformCall');
+                        const tokens = Number(item.total_tokens ?? ((item.input_tokens ?? 0) + (item.output_tokens ?? 0)));
+                        return (
+                          <div key={String(item.id ?? item.trace_id ?? idx)} className="flex items-center justify-between gap-2 px-3 py-2 text-[12px]">
+                            <div className="min-w-0 flex-1">
+                              <div className="flex items-center gap-1.5 truncate font-medium text-[var(--text)]">
+                                <span className="truncate">{modelLabel}</span>
+                                {item.requested_model === 'auto' && item.resolved_model && item.resolved_model !== 'auto' ? (
+                                  <span className="rounded bg-[var(--bg-hover)] px-1 text-[10px] font-normal text-[var(--text-muted)]">{t('workbench.autoRouted')}</span>
+                                ) : null}
+                                {Number(item.call_count) > 1 ? (
+                                  <span className="rounded bg-[var(--bg-hover)] px-1 text-[10px] font-normal text-[var(--text-muted)] tabular-nums">
+                                    {fill(t('workbench.mergedCalls'), { n: item.call_count })}
+                                  </span>
+                                ) : null}
+                              </div>
+                              <div className="mt-0.5 flex flex-wrap items-center gap-2 text-[10.5px] text-[var(--text-faint)]">
+                                {item.created_at ? <span>{formatSyncedAt(item.created_at, language)}</span> : null}
+                                {tokens > 0 ? <span className="tabular-nums">{tokens.toLocaleString()} Tokens</span> : null}
+                                {item.remark ? <span className="truncate max-w-[180px]">{item.remark}</span> : null}
+                              </div>
+                            </div>
+                            <span className={`shrink-0 font-semibold tabular-nums ${cost < 0 || ledgerMode === 'traces' ? 'text-[var(--text)]' : 'text-emerald-500'}`}>
+                              {fill(t('workbench.pointsDelta'), { signed: ledgerMode === 'traces' ? `-${Math.abs(cost)}` : cost > 0 ? `+${cost}` : cost })}
+                            </span>
+                          </div>
+                        );
+                      })}
+                    </div>
+                  )}
+
+                  {isFormal && (ledgerData.total ?? 0) > 15 ? (
+                    <div className="mt-auto flex items-center justify-between pt-2 text-[11.5px] text-[var(--text-muted)]">
+                      <button
+                        type="button"
+                        disabled={ledgerPage <= 1 || ledgerBusy}
+                        onClick={() => setLedgerPage((p) => Math.max(1, p - 1))}
+                        className="inline-flex items-center gap-1 rounded border border-[var(--border)] px-2 py-1 hover:bg-[var(--bg-hover)] disabled:opacity-40"
+                      >
+                        <ChevronLeft size={12} /> {t('workbench.prevPage')}
+                      </button>
+                      <span className="tabular-nums">{ledgerPage} / {totalPages}</span>
+                      <button
