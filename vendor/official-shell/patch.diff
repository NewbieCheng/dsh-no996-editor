+                            pricingData!.services!.map((s, idx) => (
+                              <div key={String(s.service_code || idx)} className="flex items-center justify-between gap-2 px-3 py-2">
+                                <div className="min-w-0">
+                                  <div className="font-medium text-[var(--text)]">{s.display_name || s.service_code}</div>
+                                  <div className="font-mono text-[10.5px] text-[var(--text-faint)]">{s.service_code}</div>
+                                </div>
+                                <div className="shrink-0 text-right text-[11px] tabular-nums text-[var(--text-muted)]">
+                                  {fill(t('workbench.pointsPerUnit'), { n: s.points_per_unit ?? 0, unit: s.unit_label || t('workbench.unitOnce') })}
+                                </div>
+                              </div>
+                            ))
+                          )}
+                        </div>
+                      </div>
+                    </>
+                  )}
+                </div>
