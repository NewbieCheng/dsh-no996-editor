+  text-underline-offset: 3px;
+}
+.no996-bay-quiet:hover:not(:disabled) { color: ${TEXT}; }
+.no996-bay-quiet:disabled { opacity: .5; cursor: not-allowed; }
+.no996-bay-default {
+  text-align: center;
+  text-decoration: none;
+}
+.no996-bay-error {
+  margin: 12px 32px 0;
+  font-size: 12.5px;
+  color: #f08888;
+}
+@media (prefers-reduced-motion: reduce) {
