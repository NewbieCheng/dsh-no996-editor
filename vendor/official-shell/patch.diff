+              {tab === 'ledger' ? (
+                <div className="flex min-h-0 flex-1 flex-col gap-3">
+                  <div className="flex items-center justify-between gap-2">
+                    <div className="inline-flex rounded-md border border-[var(--border)] bg-[var(--bg-field)] p-0.5 text-[11.5px]">
