+                        <div className="divide-y divide-[var(--border)] rounded-md border border-[var(--border)]">
+                          {(pricingData?.models ?? []).length === 0 ? (
+                            <div className="px-3 py-3 text-[var(--text-muted)]">{t('workbench.pricingEmptyModels')}</div>
+                          ) : (
+                            pricingData!.models!.map((m, idx) => (
+                              <div key={String(m.model_code || idx)} className="flex items-center justify-between gap-2 px-3 py-2">
+                                <div className="min-w-0">
+                                  <div className="flex items-center gap-1.5 font-medium text-[var(--text)]">
+                                    <span className="truncate">{m.display_name || m.model_code}</span>
+                                    {m.supports_vision ? (
+                                      <span className="rounded bg-[var(--bg-hover)] px-1 text-[10px] font-normal text-[var(--text-muted)]">{t('workbench.visionBadge')}</span>
+                                    ) : null}
+                                  </div>
+                                  <div className="font-mono text-[10.5px] text-[var(--text-faint)]">{m.model_code}</div>
+                                </div>
+                                <div className="shrink-0 text-right text-[11px] tabular-nums text-[var(--text-muted)]">
+                                  {m.fixed_points && m.fixed_points > 0
+                                    ? fill(t('workbench.pointsPerCall'), { n: m.fixed_points })
+                                    : fill(t('workbench.pointsPerTok'), { input: m.points_per_1k_input ?? 0, output: m.points_per_1k_output ?? 0 })}
+                                </div>
+                              </div>
+                            ))
+                          )}
+                        </div>
+                      </div>
+
+                      <div>
+                        <div className="mb-1.5 text-[11.5px] font-medium text-[var(--text-faint)]">{t('workbench.pricingServices')}</div>
+                        <div className="divide-y divide-[var(--border)] rounded-md border border-[var(--border)]">
+                          {(pricingData?.services ?? []).length === 0 ? (
+                            <div className="px-3 py-3 text-[var(--text-muted)]">{t('workbench.pricingEmptyServices')}</div>
