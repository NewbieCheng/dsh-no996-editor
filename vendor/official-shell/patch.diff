@@ -0,0 +1,659 @@
+/**
+ * In-app Error & Diagnostic Log Center for 不加班工作台 / OpenFilm.
+ *
+ * Unifies Host persistent daily logs (`$DSH_HOME/no996-openfilm/logs/diagnostics-*.jsonl`),
+ * live page buffer (`window.__no996DiagBuffer`), Studio `problems.jsonl`, and active
+ * session diagnostics into one searchable, copyable, exportable drawer.
+ */
+import * as React from 'react';
+import { createPortal } from 'react-dom';
+import {
+  AlertCircle,
+  AlertTriangle,
+  Bot,
+  Check,
+  ChevronDown,
+  ChevronRight,
+  Copy,
+  Download,
+  Info,
+  RefreshCw,
+  Search,
+  Sparkles,
+  Trash2,
+  X,
+} from 'lucide-react';
+import { studioHost } from '@/lib/host';
+
+export type DiagEntry = {
+  id: string;
+  ts: string;
+  level: 'error' | 'warn' | 'info' | string;
+  layer: string;
+  traceId?: string;
+  code?: string;
+  channel?: string;
+  httpStatus?: number | null;
+  durationMs?: number | null;
+  projectId?: string;
+  conversation?: string;
+  sessionDigest?: string;
+  location?: string;
+  summary?: string;
+  detail?: Record<string, unknown> | null;
+};
+
+type DiagStats = {
+  dir?: string;
+  retentionDays?: number;
+  maxTotalBytes?: number;
+  fileCount?: number;
+  totalBytes?: number;
+  oldestDate?: string | null;
+  newestDate?: string | null;
+  recentErrors?: number;
+  recentWarnings?: number;
+};
+
+type DiagListResponse = {
+  items?: DiagEntry[];
+  total?: number;
+  stats?: DiagStats;
+};
+
+type DiagExportResponse = {
+  exportedAt?: string;
+  environment?: Record<string, unknown>;
+  studio?: Record<string, unknown>;
+  preset?: Record<string, unknown>;
+  turns?: Record<string, unknown> | null;
+  stats?: DiagStats;
+  entries?: DiagEntry[];
+  studioProblems?: Array<Record<string, unknown>>;
+  hostLogTail?: Array<Record<string, unknown>>;
+  markdown?: string;
+};
+
+async function diagRpc<T>(channel: string, payload: Record<string, unknown> = {}): Promise<T> {
+  const response = await fetch('/__dsh/official-rpc', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ channel, payload }),
+  });
+  if (!response.ok) {
+    let detail = '';
+    try { detail = (await response.text()).slice(0, 200); } catch { /* ignore */ }
+    throw new Error(detail || `HTTP ${response.status}`);
+  }
+  return response.json() as Promise<T>;
+}
+
+function formatBytes(bytes = 0): string {
+  if (bytes < 1024) return `${bytes} B`;
+  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KiB`;
+  return `${(bytes / (1024 * 1024)).toFixed(2)} MiB`;
+}
+
+function formatTime(iso: string): string {
+  const ms = Date.parse(iso);
+  if (!Number.isFinite(ms)) return iso;
+  try {
+    return new Date(ms).toLocaleString('zh-CN', {
+      hour12: false,
+      month: '2-digit',
+      day: '2-digit',
+      hour: '2-digit',
+      minute: '2-digit',
+      second: '2-digit',
+    });
+  } catch {
+    return iso;
+  }
+}
+
+function currentProjectIdFromUrl(): string {
+  const m = /^\/projects\/([A-Za-z0-9_-]{6,40})\/?$/.exec(window.location.pathname);
+  return m ? m[1] : '';
+}
+
+function readPageDiagBuffer(): DiagEntry[] {
+  const raw = (window as unknown as { __no996DiagBuffer?: unknown[] }).__no996DiagBuffer;
+  return Array.isArray(raw) ? (raw as DiagEntry[]) : [];
+}
+
+function buildAgentPrompt(report: DiagExportResponse, focused?: DiagEntry | null): string {
+  const logDir = report.stats?.dir ? `本地日志目录: ${report.stats.dir}` : '';
+  const focusLines = focused
+    ? [
+        '当前重点异常:',
+        `- 时间: ${focused.ts}`,
+        `- 层级/错误码: [${focused.layer}] ${focused.code || ''} ${focused.channel || ''} ${focused.httpStatus ? `HTTP ${focused.httpStatus}` : ''}`,
+        focused.traceId ? `- TraceID: ${focused.traceId}` : '',
+        focused.location ? `- 定位位置: ${focused.location}` : '',
+        focused.summary ? `- 摘要: ${focused.summary}` : '',
+        focused.detail ? `- 详情: ${JSON.stringify(focused.detail)}` : '',
+        '',
+      ].filter(Boolean)
+    : [];
+  const excerpt = (report.markdown || '').slice(0, 4200);
+  return [
+    '请帮我诊断下面这个 No996 Studio / OpenFilm 异常，定位根因并给出修复建议：',
+    logDir,
+    ...focusLines,
+    excerpt,
+  ].filter(Boolean).join('\n');
+}
+
+export function DiagnosticLogsDrawer({
+  open,
+  initialTraceId = '',
+  onClose,
+}: {
+  open: boolean;
+  initialTraceId?: string;
+  onClose: () => void;
+}) {
+  const [level, setLevel] = React.useState<'all' | 'error' | 'warn+'>('all');
+  const [layer, setLayer] = React.useState<string>('all');
+  const [search, setSearch] = React.useState<string>('');
+  const [items, setItems] = React.useState<DiagEntry[]>([]);
+  const [total, setTotal] = React.useState(0);
+  const [stats, setStats] = React.useState<DiagStats | null>(null);
+  const [busy, setBusy] = React.useState(false);
+  const [loadError, setLoadError] = React.useState('');
+  const [expandedId, setExpandedId] = React.useState<string>('');
+  const [notice, setNotice] = React.useState<string>('');
+  const [manualText, setManualText] = React.useState<string>('');
+
+  const load = React.useCallback(async (overrideSearch?: string) => {
+    setBusy(true);
+    setLoadError('');
+    const query = overrideSearch !== undefined ? overrideSearch : search;
+    try {
+      const res = await diagRpc<DiagListResponse>('diag:list', {
+        level,
+        layer,
+        search: query,
+        limit: 150,
+      });
+      const hostItems = Array.isArray(res?.items) ? res.items : [];
+      const pageItems = readPageDiagBuffer().filter((entry) => {
+        if (level === 'error' && entry.level !== 'error') return false;
+        if (level === 'warn+' && entry.level !== 'error' && entry.level !== 'warn') return false;
+        if (layer !== 'all' && entry.layer !== layer) return false;
+        if (query.trim()) {
+          const needle = query.trim().toLowerCase();
+          const hay = `${entry.code ?? ''} ${entry.channel ?? ''} ${entry.location ?? ''} ${entry.summary ?? ''} ${entry.traceId ?? ''}`.toLowerCase();
+          if (!hay.includes(needle)) return false;
+        }
+        return true;
+      });
+      const merged = new Map<string, DiagEntry>();
+      for (const entry of [...hostItems, ...pageItems]) {
+        if (entry && typeof entry.id === 'string') merged.set(entry.id, entry);
+      }
+      const list = [...merged.values()].sort((a, b) => (b.ts || '').localeCompare(a.ts || ''));
+      setItems(list);
+      setTotal(Math.max(Number(res?.total) || 0, list.length));
+      if (res?.stats) setStats(res.stats);
+      if (query && list.length > 0) setExpandedId(list[0].id);
+    } catch (err) {
+      const pageItems = readPageDiagBuffer();
+      setItems(pageItems.slice().reverse());
+      setTotal(pageItems.length);
+      setLoadError(String((err as Error)?.message || err));
+    } finally {
+      setBusy(false);
+    }
+  }, [level, layer, search]);
+
+  React.useEffect(() => {
+    if (!open) return;
+    if (initialTraceId) setSearch(initialTraceId);
+    void load(initialTraceId || undefined);
+  }, [open, initialTraceId]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  React.useEffect(() => {
+    if (!open) return;
+    void load();
+  }, [level, layer]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  React.useEffect(() => {
+    if (!open) return;
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') onClose();
+    };
+    window.addEventListener('keydown', onKey);
+    return () => window.removeEventListener('keydown', onKey);
+  }, [open, onClose]);
+
+  const flashNotice = (msg: string) => {
+    setNotice(msg);
+    window.setTimeout(() => setNotice((cur) => (cur === msg ? '' : cur)), 3200);
+  };
+
+  const copyText = async (text: string, okMsg: string) => {
+    try {
+      await navigator.clipboard.writeText(text);
+      setManualText('');
+      flashNotice(okMsg);
+    } catch {
+      setManualText(text);
+      flashNotice('无法自动写入剪贴板，请在下方文本框手动全选复制');
+    }
+  };
+
+  const handleCopyForDev = async () => {
+    try {
+      const data = await diagRpc<DiagExportResponse>('diag:export', {
+        projectId: currentProjectIdFromUrl(),
+        level,
+        layer,
+        limit: 80,
+      });
+      await copyText(data.markdown || JSON.stringify(data, null, 2), '已复制开发者诊断报告');
+    } catch (err) {
+      const fallback = JSON.stringify({ error: String((err as Error)?.message || err), entries: items.slice(0, 30) }, null, 2);
