+
+type Wallet = {
+  available_points?: number | null;
+  points_balance?: number | null;
+  period_points_balance?: number | null;
+  expert_points_balance?: number | null;
+  period_expires_at?: string | null;
+  cached_at?: string;
+  stale?: boolean;
+  source?: string;
+  message?: string;
+};
+
+type AuthStatus = {
+  loggedIn: boolean;
+  dev?: boolean;
+  guest?: boolean;
+  account?: string;
+  displayName?: string;
+  credits?: number | null;
+  balance?: Wallet;
+};
+
+type CapabilitiesEndpoint = {
+  capability?: string;
+  method?: string;
+  path?: string;
+  ready?: boolean;
+  reserved?: boolean;
+  note?: string;
+};
+
+type CapabilitiesPayload = {
+  gateway_base_url?: string;
+  auto_vision_routing_enabled?: boolean;
+  exposed_services?: string[];
+  endpoints?: CapabilitiesEndpoint[];
+  limits?: {
+    effective_rpm?: number;
+    effective_daily_tokens?: number;
+    effective_max_keys?: number;
+    user_quota_disabled?: boolean;
+  };
+};
+
+type OverviewResponse = {
+  status: AuthStatus;
+  balance: Wallet;
+  capabilities: CapabilitiesPayload | null;
+  walletDirtyAt?: number;
+};
+
+type TraceItem = {
+  id?: number | string;
+  trace_id?: string;
+  created_at?: string;
+  model_code?: string;
+  model?: string;
+  requested_model?: string;
+  resolved_model?: string;
+  capability?: string;
+  service_code?: string;
+  provider_code?: string;
+  input_tokens?: number;
+  output_tokens?: number;
+  total_tokens?: number;
+  points_cost?: number;
+  charged_points?: number;
+  delta?: number;
+  call_count?: number;
+  reason?: string;
+  remark?: string;
+  status?: string;
+};
+
+type TracesResponse = {
+  mode?: 'traces' | 'ledgers';
+  page?: number;
+  page_size?: number;
+  items?: TraceItem[];
+  total?: number;
+};
+
+type PricingModelRow = {
+  model_code?: string;
+  display_name?: string;
+  points_per_1k_input?: number;
+  points_per_1k_output?: number;
+  fixed_points?: number;
+  billing_mode?: string;
+  supports_vision?: boolean;
+  available?: boolean;
+};
+
+type PricingServiceRow = {
+  service_code?: string;
+  display_name?: string;
+  unit_label?: string;
+  points_per_unit?: number;
+  available?: boolean;
