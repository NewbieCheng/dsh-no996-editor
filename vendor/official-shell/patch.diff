+  const style = document.createElement('style');
+  style.id = STYLE_ID;
+  style.textContent = `
+@keyframes no996-bay-in {
+  from { opacity: 0; transform: translateY(10px); }
+  to { opacity: 1; transform: none; }
+}
+.no996-bay-scrim {
+  position: fixed; inset: 0; z-index: 9000;
+  display: flex; align-items: center; justify-content: center;
+  padding: clamp(16px, 3vw, 36px);
+  background:
+    radial-gradient(90% 70% at 50% 35%, rgba(18,28,48,.7) 0%, transparent 58%),
+    linear-gradient(180deg, rgba(5,15,38,.82), rgba(5,8,16,.92));
+  font-family: inherit;
+}
+.no996-bay-stage {
+  width: min(1080px, 96vw);
+  border: 1px solid rgba(255,100,0,.22);
+  border-radius: 6px;
+  background: linear-gradient(180deg, rgba(255,255,255,.04), transparent 28%), ${PANEL};
+  padding: 26px 0 24px;
+  box-shadow: 0 1px 0 rgba(255,255,255,.06) inset, 0 28px 64px rgba(0,0,0,.55);
+  animation: no996-bay-in 220ms ease-out both;
+  text-align: center;
+}
+.no996-bay-title {
+  margin: 0;
+  padding: 0 32px;
+  font-size: 22px;
+  font-weight: 700;
+  letter-spacing: .02em;
+  color: ${TEXT};
+  line-height: 1.25;
+}
+.no996-bay-sub {
+  margin: 8px auto 0;
+  padding: 0 32px;
+  max-width: 32rem;
+  font-size: 13.5px;
+  line-height: 1.55;
+  color: ${MUTE};
+}
+.no996-bay-rule {
+  margin: 16px auto 0;
+  width: min(220px, 48%);
+  border-bottom: 2px dashed rgba(185,173,152,.35);
+}
+.no996-bay-grid {
+  display: flex;
+  flex-wrap: nowrap;
+  gap: 12px;
+  margin-top: 20px;
+  padding: 0 28px 6px;
