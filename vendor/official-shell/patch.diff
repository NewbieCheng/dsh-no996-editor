+'use client';
+
+import React from 'react';
+import { Check, Clapperboard, Compass, MessageSquare, Sparkles } from 'lucide-react';
+import { Popover, keepFocus } from '@/components/Popover';
+import { POPOVER_CHROME } from '@/components/ComposerCard';
+import { Tooltip } from '@/components/Tooltip';
+import { useT } from '@/i18n';
+import type { LocalAgentId } from '@/lib/desktop-bridge';
+import { setAgentAutoExport, setAgentWorkMode, useAgentWorkMode, type WorkMode } from '@/lib/local-agent-run';
+
+const CARD_W = 264;
+
+const MODES: ReadonlyArray<{ id: WorkMode; icon: typeof Sparkles }> = [
+  { id: 'auto', icon: Sparkles },
+  { id: 'chat', icon: MessageSquare },
+  { id: 'design', icon: Compass },
+  { id: 'produce', icon: Clapperboard },
+];
+
+export function WorkModePill({
+  projectId,
+  conversation,
+  agent,
+  disabled = false,
+}: {
+  projectId: string;
+  conversation: string;
+  agent: LocalAgentId;
+  disabled?: boolean;
+}) {
+  const t = useT();
+  const state = useAgentWorkMode(projectId, conversation, agent);
+  const [open, setOpen] = React.useState(false);
+
+  const activeMode = state.mode;
+  const effective = state.effective;
+  const autoExport = state.autoExport === true;
+  const Icon = activeMode === 'auto'
+    ? (effective === 'design' ? Compass : effective === 'produce' ? Clapperboard : Sparkles)
+    : (MODES.find((m) => m.id === activeMode)?.icon ?? Sparkles);
+
+  const baseShort = activeMode === 'auto' && effective !== 'chat'
+    ? `${t('workMode.shortAuto')}·${t(effective === 'design' ? 'workMode.shortDesign' : 'workMode.shortProduce')}`
+    : t(`workMode.short_${activeMode}` as Parameters<typeof t>[0]);
+  const shortText = autoExport && activeMode !== 'chat'
+    ? `${baseShort}·${t('workMode.shortExport')}`
+    : baseShort;
+
+  const accentClass = activeMode === 'design' || (activeMode === 'auto' && effective === 'design')
+    ? 'text-[#f0b44b]'
+    : activeMode === 'produce' || (activeMode === 'auto' && effective === 'produce')
+      ? 'text-[#4fd1a5]'
+      : 'text-[var(--text-muted)]';
+
+  const pick = (mode: WorkMode) => {
+    setOpen(false);
+    void setAgentWorkMode(projectId, conversation, agent, mode);
+  };
+
+  const toggleAutoExport = () => {
+    void setAgentAutoExport(projectId, conversation, agent, !autoExport);
+  };
+
+  return (
+    <Popover
+      open={open}
+      onOpenChange={setOpen}
+      placement="top"
+      align="start"
+      bare
+      trigger={
+        <Tooltip label={state.reason ? `${t('workMode.tooltip')} — ${state.reason}` : t('workMode.tooltip')}>
+          <button
+            type="button"
+            disabled={disabled}
+            onMouseDown={keepFocus}
+            data-chat-work-mode={activeMode}
+            data-chat-work-phase={effective}
+            data-chat-auto-export={autoExport ? 'true' : 'false'}
+            className="group inline-flex h-8 max-w-[152px] items-center gap-1 rounded-full px-2 text-[12px] font-medium transition hover:bg-[var(--bg-hover)] disabled:cursor-not-allowed disabled:opacity-50"
+          >
+            <Icon size={12.5} strokeWidth={1.9} className={`shrink-0 transition ${accentClass}`} />
+            <span className="truncate text-[var(--text-muted)] transition group-hover:text-[var(--text)]">
+              {shortText}
+            </span>
+          </button>
+        </Tooltip>
+      }
+    >
+      <div style={{ ...POPOVER_CHROME, width: Math.min(CARD_W, Math.max(220, Math.floor(window.innerWidth * 0.72))), padding: 4 }}>
+        <div className="px-2.5 pb-1 pt-1 text-[11px] font-medium text-[var(--text-faint)]">
+          {t('workMode.heading')}
+        </div>
+        {MODES.map(({ id, icon: ItemIcon }) => {
+          const selected = activeMode === id;
+          return (
+            <button
+              key={id}
+              type="button"
+              onMouseDown={keepFocus}
+              onClick={() => pick(id)}
+              className="flex w-full items-start gap-2 rounded-[6px] px-2.5 py-1.5 text-left outline-none transition hover:bg-[var(--bg-hover)] focus-visible:bg-[var(--bg-hover)]"
+            >
+              <ItemIcon size={14} className="mt-0.5 shrink-0 text-[var(--text-muted)]" />
+              <div className="min-w-0 flex-1">
+                <div className="flex items-center gap-1.5 text-[12.5px] font-medium text-[var(--text)]">
+                  <span className="truncate">{t(`workMode.label_${id}` as Parameters<typeof t>[0])}</span>
+                  {selected && id === 'auto' && effective !== 'chat' ? (
+                    <span className="rounded bg-[var(--bg-hover)] px-1 py-0.5 text-[10px] font-normal text-[var(--text-muted)]">
+                      {t(effective === 'design' ? 'workMode.shortDesign' : 'workMode.shortProduce')}
+                    </span>
+                  ) : null}
+                </div>
+                <div className="mt-0.5 text-[11px] leading-snug text-[var(--text-faint)]">
+                  {t(`workMode.desc_${id}` as Parameters<typeof t>[0])}
+                </div>
+              </div>
+              {selected ? <Check size={13} className="mt-0.5 shrink-0 text-[var(--text)]" /> : null}
+            </button>
+          );
+        })}
+        <div className="my-1 border-t border-[var(--border)]" />
+        <button
+          type="button"
+          role="switch"
+          aria-checked={autoExport}
+          onMouseDown={keepFocus}
+          onClick={toggleAutoExport}
+          data-chat-auto-export-toggle={autoExport ? 'true' : 'false'}
+          className="flex w-full items-start gap-2 rounded-[6px] px-2.5 py-1.5 text-left outline-none transition hover:bg-[var(--bg-hover)] focus-visible:bg-[var(--bg-hover)]"
+        >
+          <div className="min-w-0 flex-1">
+            <div className="text-[12.5px] font-medium text-[var(--text)]">
+              {t('workMode.autoExportLabel')}
+            </div>
+            <div className="mt-0.5 text-[11px] leading-snug text-[var(--text-faint)]">
+              {t('workMode.autoExportDesc')}
+            </div>
+          </div>
+          <span
+            aria-hidden="true"
+            className={`mt-0.5 inline-flex h-4 w-7 shrink-0 items-center rounded-full p-0.5 transition ${
+              autoExport ? 'bg-[#4fd1a5]' : 'bg-[var(--border)]'
+            }`}
+          >
+            <span
+              className={`h-3 w-3 rounded-full bg-white shadow transition-transform ${
+                autoExport ? 'translate-x-3' : 'translate-x-0'
+              }`}
+            />
+          </span>
+        </button>
+      </div>
+    </Popover>
+  );
+}
