+function No996Templates({ onCopy, onBlank, busy }: { onCopy: (id: string) => void; onBlank: () => void; busy: boolean }) {
+  const [cards, setCards] = React.useState<No996Template[]>([]);
+  const [failed, setFailed] = React.useState(false);
+  const zh = document.documentElement.lang.toLowerCase().startsWith('zh');
+  React.useEffect(() => {
+    let live = true;
+    void fetch('/__dsh/official-rpc', {
+      method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ channel: 'template:list', payload: {} }),
+    }).then(async (response) => {
+      if (!response.ok) throw new Error('template list unavailable');
+      return response.json() as Promise<{ templates?: No996Template[] }>;
+    }).then((data) => {
+      if (live) setCards((Array.isArray(data.templates) ? data.templates : []).filter((card) => card && card.id !== 'custom'));
+    }).catch(() => { if (live) setFailed(true); });
+    return () => { live = false; };
+  }, []);
+  return (
+    <section className="px-6 pb-4" aria-label={zh ? 'No996 模板' : 'No996 templates'}>
+      <div className="mb-3 flex items-center justify-end gap-3">
+        <button type="button" disabled={busy} onClick={onBlank} className="rounded-lg border border-[var(--border)] px-3 py-1.5 text-sm text-[var(--text)] hover:bg-[var(--bg-hover)] disabled:opacity-50">{zh ? '空白开工' : 'Start blank'}</button>
+      </div>
+      {failed ? <p role="status" className="text-sm text-[var(--text-muted)]">{zh ? '模板暂不可用，仍可浏览示例或新建空白项目。' : 'Templates are unavailable; browse examples or start blank.'}</p> : null}
+      <div className="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-4">
+        {cards.map((card) => <article key={card.id} className="flex flex-col gap-2 rounded-lg border border-[var(--border)] p-3">
+          <div className="flex items-center justify-between gap-2">
+            <h3 className="flex min-w-0 items-center gap-1.5 text-sm font-semibold text-[var(--text)]">
+              <span className="flex h-6 w-6 shrink-0 items-center justify-center rounded-md bg-[var(--bg-field)] text-[var(--text-muted)]">
+                <No996TemplateIcon id={card.id} />
+              </span>
+              <span className="truncate">{card.productTitle || card.title}</span>
+            </h3>
+            {card.featured ? <span className="shrink-0 rounded-full bg-[rgba(255,194,75,0.16)] px-2 py-0.5 text-[10px] font-medium text-[#e2a32e]">{zh ? '首推' : 'Featured'}</span> : null}
+          </div>
+          <p className="flex-1 text-xs leading-relaxed text-[var(--text-muted)]">{card.productBlurb || card.description}</p>
+          <div className="mt-1 flex justify-end">
+            <button type="button" disabled={busy} onClick={() => onCopy(card.id)} className="self-end rounded-md border border-[var(--border)] px-2.5 py-1 text-xs font-medium text-[var(--text)] hover:bg-[var(--bg-hover)] disabled:opacity-50">{zh ? '复制开工' : 'Copy and start'}</button>
+          </div>
+        </article>)}
+      </div>
+    </section>
+  );
+}
