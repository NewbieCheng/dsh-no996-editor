+/**
+ * no996-editor: re-read this project's conversations from the Host and replace what
+ * the page holds.
+ *
+ * The sidebar outside this page can delete or add a conversation, and Studio can
+ * lose a project folder while the chat is open. This page keeps its list in state
+ * from when the project opened, so without a re-read the session bar keeps drawing
+ * a conversation that no longer exists. Returns whether anything changed, so a
+ * poll can skip the re-render.
+ */
+export async function refreshChatSessions(project: string): Promise<boolean> {
+  // The bridge's load result is only loosely typed (`sessions: unknown[]`), so narrow it
+  // here instead of declaring the precise list and failing the typecheck.
+  let kept: { sessions?: unknown[]; last?: unknown } | null = null;
+  try { kept = await app.chat.load(project); } catch { return false; }
+  const next = (Array.isArray(kept?.sessions) ? kept.sessions : [])
+    .filter((entry: unknown): entry is ProjectSessionItem => {
+      if (!entry || typeof entry !== 'object') return false;
+      const row = entry as { id?: unknown; createdAt?: unknown };
+      return typeof row.id === 'string' && typeof row.createdAt === 'string';
+    });
+  const current = record(project).sessions;
+  const stamp = (list: ProjectSessionItem[]) => list.map(entry => `${entry.id}\u0000${entry.updatedAt ?? ''}\u0000${entry.title ?? ''}`).join('\u0001');
+  if (stamp(next) === stamp(current)) return false;
+  const chat = record(project);
+  const live = new Set(next.map(item => item.id));
+  const removed = new Set(current.filter(item => !live.has(item.id)).map(item => item.id));
+  chat.sessions = next;
+  chat.last = typeof kept?.last === 'string' && live.has(kept.last) ? kept.last : null;
+  chat.turns = chat.turns.filter(entry => !removed.has(entry.turn.sessionId ?? ''));
+  return true;
+}
+
+/** An explicit handoff must verify the exact target, even after the ordinary
+ * opening load timed out and created an empty cache. Never select `last` here. */
+export async function readRequestedConversation(project: string, id: string, sessionId: string, stillCurrent: () => boolean) {
+  const kept = await app.chat.load(project);
+  if (!stillCurrent() || readFor.get(project) !== id) return 'superseded';
+  const matches = (Array.isArray(kept?.sessions) ? kept.sessions : []).filter(entry =>
+    entry && typeof entry === 'object' && (entry as { id?: string }).id === sessionId) as ProjectSessionItem[];
+  if (matches.length !== 1) return 'missing';
+  const [selected] = matches;
+  if (!selected || selected.archived === true) return 'archived';
+  const chat = record(project);
+  const turns = (Array.isArray(kept?.turns) ? kept.turns : []) as SavedTurn[];
+  joinKept(chat, { sessions: [selected], turns: turns.filter(entry => entry?.turn?.sessionId === sessionId) });
+  chat.sessions = chat.sessions.map(row => row.id === sessionId ? selected : row);
+  // If the initial read failed, leave its read-before-write guard in place:
+  // only the target was merged here, not the complete project history.
+  return 'ready';
+}
