+  };
+
+  const loadCaptcha = async () => {
+    setCaptcha(was => ({ ...was, open: true, id: '', error: '', svg: '', clicks: [], wrong: 0, marks: [] }));
+    try {
+      const data = await auth('captcha', { type: 'click' });
+      if (!data?.id || !data?.svg) { setCaptcha(was => ({ ...was, error: t('login.captchaLoadRetry') })); return; }
+      // Keep the board's native 360×240 ratio (xMidYMid meet) so icons don't stretch
+      // and click hit-boxes stay aligned with what the user sees.
+      const svg = String(data.svg).replace(/<svg\b([^>]*)>/, (_match: string, attrs: string) => (
+        /\spreserveAspectRatio\s*=/.test(attrs)
+          ? '<svg' + attrs.replace(/\spreserveAspectRatio\s*=\s*(["']).*?\1/, ' preserveAspectRatio="xMidYMid meet"') + '>'
