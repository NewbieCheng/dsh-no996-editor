+'use client';
+
+/**
+ * The pre-auth gate. Copy goes through studio i18n (`login.*`).
+ *
+ * Behaviour that must not change (it is the door to everything):
+ * - three modes: login / register / reset, with the same validation and copy;
+ * - the click captcha (single pick, or a sequence in the shown order), refreshed
+ *   after two wrong sequence clicks;
+ * - remember-account through `auth:remember-*`;
+ * - `auth:status` decides whether the gate is on screen at all;
+ * - DEV styling: `/?loginPreview=1` (or `no996-open-account-login`) forces the
+ *   gate even while Host keeps Dev mode logged-in;
+ * - guest enter opens an in-memory Host guest session (credits 0) when the
+ *   workbench is unreachable — for debugging, not a real account.
+ */
+import React from 'react';
+import { useLanguage, useT } from '@/i18n';
+import { BRAND_WHITE } from './brand-mark';
+import './login.css';
+
+const isLoginPreview = () => {
+  try { return new URLSearchParams(location.search).get('loginPreview') === '1'; }
+  catch { return false; }
+};
+
+const clearLoginPreview = () => {
+  try {
+    const url = new URL(location.href);
+    if (!url.searchParams.has('loginPreview')) return;
+    url.searchParams.delete('loginPreview');
+    if (!url.searchParams.has('library')) url.searchParams.set('library', '1');
+    const next = `${url.pathname}${url.search}`;
+    history.replaceState(null, '', next);
+    window.dispatchEvent(new PopStateEvent('popstate'));
+  } catch { /* ignore */ }
+};
+
+type Mode = 'login' | 'register' | 'reset';
+type Captcha = {
+  open: boolean;
+  id: string;
+  prompt: string;
+  sequence: string[];
+  hint: string;
+  svg: string;
+  error: string;
+  clicks: string[];
+  wrong: number;
+  marks: { x: number; y: number; n: number }[];
+};
+
+const DAY_KEYS = ['day_work', 'day_meeting', 'day_edit', 'day_rework', 'day_wrap', 'day_shutdown', 'day_off'] as const;
+const DUR = [1, 1.5, 1.5, 2.2, 1.2, 0.8, 0.8];
+const TOTAL = 9;
+const ICON_KEYS = ['fish', 'cake', 'egg', 'milk', 'chili', 'potato', 'chocolate', 'garlic', 'scallion', 'mint', 'snow_lotus', 'sweet_potato', 'bean'] as const;
+type TFn = (path: string) => string;
+const fill = (template: string, values: Record<string, string | number>) =>
+  template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''));
+const dayNames = (t: TFn) => DAY_KEYS.map((key) => t(`login.${key}`));
+const iconLabel = (t: TFn, icon?: string) => {
+  if (icon && (ICON_KEYS as readonly string[]).includes(icon)) return t(`login.icon_${icon}`);
+  return t('login.iconFallback');
+};
+const DAY_SECONDS = 150;
+/** One pleasant still from the city reel — ambient motion is CSS (60fps), not renderAt. */
+const CITY_STILL = 2.35;
+const PAUSE_ICON = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2"/><rect x="14" y="5" width="4" height="14" rx="1.2"/></svg>';
+const PLAY_ICON = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>';
+
+async function rpc(channel: string, payload: unknown = {}) {
+  const reply = await fetch('/__dsh/official-rpc', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ channel, payload }),
+  });
+  if (!reply.ok) throw new Error('HTTP ' + reply.status);
+  return reply.json();
+}
+
+async function auth(action: string, fields: Record<string, unknown>) {
+  const data = await rpc('auth:action', { action, ...fields });
+  if (data && data.ok === false) throw new Error(data.message || data.error || 'Request failed');
+  return data;
+}
+
+const pad2 = (n: number) => (n < 10 ? '0' + n : String(n));
+const smooth = (a: number, b: number, x: number) => {
+  const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
+  return t * t * (3 - 2 * t);
+};
+
+/** Sky + orb colours for a point in the day: morning dark, noon bright, warm afternoon, orange dusk, deep blue night. */
+function skyFor(v: number) {
+  const mix = (layers: [number, number, number, number][]) => {
+    let r = 0, g = 0, b = 0, a = 0;
+    for (const [lr, lg, lb, la0] of layers) {
+      const la = Math.round(la0 * 50) / 50;
+      if (la <= 0) continue;
+      r = lr * la + r * (1 - la);
+      g = lg * la + g * (1 - la);
+      b = lb * la + b * (1 - la);
+      a = la + a * (1 - la);
+    }
+    return `rgba(${Math.round(r)},${Math.round(g)},${Math.round(b)},${Math.round(a * 100) / 100})`;
+  };
+  const morning = 1 - smooth(0.04, 0.3, v);
+  const day = smooth(0.1, 0.28, v) * (1 - smooth(0.5, 0.72, v));
+  const warm = smooth(0.45, 0.72, v) * (1 - smooth(0.82, 1, v));
+  const dusk = smooth(0.62, 0.86, v) * (1 - smooth(0.95, 1, v));
+  const night = smooth(0.8, 1, v);
+  // Keep a real sky wash over the still city so midday is not stuck on vector-blue.
+  const top = mix([
+    [6, 18, 48, morning * 0.72],
+    [120, 175, 255, day * 0.58],
+    [255, 196, 120, warm * 0.4],
+    [255, 104, 56, dusk * 0.62],
+    [8, 12, 40, night * 0.82],
+  ]);
+  const bottom = mix([
+    [10, 40, 90, morning * 0.7],
+    [160, 200, 255, day * 0.5],
+    [255, 150, 80, warm * 0.38],
+    [38, 18, 58, dusk * 0.6],
+    [3, 6, 20, night * 0.82],
+  ]);
+  return { sky: `linear-gradient(180deg,${top} 0%,${bottom} 100%)`, night };
+}
+
+function promptHint(t: TFn, prompt: string, icon?: string) {
+  const label = iconLabel(t, icon);
+  if (prompt === 'click_largest') return fill(t('login.captchaLargest'), { icon: label });
+  if (prompt === 'click_smallest') return fill(t('login.captchaSmallest'), { icon: label });
+  if (prompt === 'click_second_smallest') return fill(t('login.captchaSecondSmallest'), { icon: label });
+  if (prompt === 'click_icon') return fill(t('login.captchaIcon'), { icon: label });
+  if (prompt === 'click_sequence') return t('login.captchaSequence');
+  if (prompt === 'click_size_asc') return fill(t('login.captchaSizeAsc'), { icon: label });
+  if (prompt === 'click_size_desc') return fill(t('login.captchaSizeDesc'), { icon: label });
+  return t('login.captchaDefault');
+}
+
+const isSequence = (prompt: string) => prompt === 'click_sequence' || prompt === 'click_size_asc' || prompt === 'click_size_desc';
+
+export function LoginGate() {
+  const t = useT();
+  const language = useLanguage();
+  const names = React.useMemo(() => dayNames(t), [t, language]);
+  const namesRef = React.useRef(names);
+  namesRef.current = names;
+  const tRef = React.useRef(t);
+  tRef.current = t;
+  const [visible, setVisible] = React.useState(false);
+  const [accountPrompt, setAccountPrompt] = React.useState(false);
+  const [mode, setMode] = React.useState<Mode>('login');
+  const [account, setAccount] = React.useState('');
+  const [password, setPassword] = React.useState('');
+  const [code, setCode] = React.useState('');
+  const [invite, setInvite] = React.useState('');
+  const [displayName, setDisplayName] = React.useState('');
+  const [remember, setRemember] = React.useState(true);
+  const [showPassword, setShowPassword] = React.useState(false);
+  const [message, setMessage] = React.useState('');
+  const [isError, setIsError] = React.useState(false);
+  const [busy, setBusy] = React.useState(false);
+  const [otpWait, setOtpWait] = React.useState(0);
+  const [captcha, setCaptcha] = React.useState<Captcha>({ open: false, id: '', prompt: '', sequence: [], hint: '', svg: '', error: '', clicks: [], wrong: 0, marks: [] });
+  const [playing, setPlaying] = React.useState(true);
+  const [raining, setRaining] = React.useState(false);
+  const [scrubbing, setScrubbing] = React.useState(false);
+  const [cardOpen, setCardOpen] = React.useState(true);
+
+  const rootRef = React.useRef<HTMLDivElement | null>(null);
+  const applyProgressRef = React.useRef<(p: number) => void>(() => {});
+  const sceneRef = React.useRef<HTMLDivElement | null>(null);
+  const cityRef = React.useRef<SVGSVGElement | null>(null);
+  const citySunRef = React.useRef<SVGCircleElement | null>(null);
+  const cityRaysRef = React.useRef<SVGGElement | null>(null);
+  const skyRef = React.useRef<HTMLDivElement | null>(null);
+  const starsRef = React.useRef<HTMLElement | null>(null);
+  const moonRef = React.useRef<HTMLDivElement | null>(null);
+  const sunAnimT = React.useRef(CITY_STILL);
+  const clockRef = React.useRef<HTMLTimeElement | null>(null);
+  const tracksRef = React.useRef<HTMLDivElement | null>(null);
+  const playheadRef = React.useRef<HTMLDivElement | null>(null);
+  const tipRef = React.useRef<HTMLSpanElement | null>(null);
+  const clipRefs = React.useRef<HTMLDivElement[]>([]);
+  const pending = React.useRef<'login' | 'otp' | ''>('');
+  const progress = React.useRef(0);
+  const playingRef = React.useRef(true);
+  const trackWidth = React.useRef(0);
+
+  const note = (text: string) => { setMessage(text); setIsError(false); };
+  const problem = (text: string) => { setMessage(text); setIsError(true); };
+
+  // ---- timeline + day-cycle sky (cheap). City is a still; street motion is CSS. ----
+  React.useEffect(() => {
+    let raf = 0;
+    let lastNow = 0;
+    let lastMinute = -1;
+    let lastSeg = -1;
+    let cityTries = 0;
+
+    const mountCity = () => {
+      const mount = (window as unknown as { __NOF_MOUNT_CITY__?: (svg: SVGSVGElement) => Promise<{ renderAt: (t: number) => void | Promise<void> }> }).__NOF_MOUNT_CITY__;
+      if (typeof mount !== 'function') {
+        if (cityTries++ < 80) window.setTimeout(mountCity, 80);
+        return;
+      }
+      const svg = cityRef.current;
+      if (!svg) {
+        if (cityTries++ < 80) window.setTimeout(mountCity, 80);
+        return;
+      }
+      // Avoid double-mount (HMR / retry) which duplicated the coral sun.
+      if (svg.dataset.nofCityMounted === '1' || svg.dataset.nofCityMounting === '1') {
+        citySunRef.current = svg.querySelector('#nof-sun');
+        cityRaysRef.current = svg.querySelector('#nof-rays');
+        driveSun(progress.current, sunAnimT.current);
+        return;
+      }
+      svg.dataset.nofCityMounting = '1';
+      void mount(svg).then(async (api) => {
+        // Paint city once. Continuous renderAt was the stutter; ambient motion is CSS @60fps.
+        await Promise.resolve(api.renderAt(CITY_STILL));
+        // Keep sun+rays inside the city world (DOM order = behind buildings).
+        const suns = svg.querySelectorAll('#nof-sun');
+        const raysAll = svg.querySelectorAll('#nof-rays');
+        suns.forEach((node, i) => { if (i > 0) node.remove(); });
+        raysAll.forEach((node, i) => { if (i > 0) node.remove(); });
+        citySunRef.current = svg.querySelector('#nof-sun');
+        cityRaysRef.current = svg.querySelector('#nof-rays');
+        svg.dataset.nofCityMounted = '1';
+        delete svg.dataset.nofCityMounting;
+        driveSun(progress.current, sunAnimT.current);
+      }).catch(() => {
+        delete svg.dataset.nofCityMounting;
+        if (cityTries++ < 80) window.setTimeout(mountCity, 200);
+      });
+    };
+
+    /**
+     * Day-timeline sun (stays behind buildings):
+     * morning small / no glow → noon grows + rays → evening shrinks to the horizon.
+     */
+    const driveSun = (v: number, animT: number) => {
+      const sun = citySunRef.current;
+      const raysG = cityRaysRef.current;
+      if (!sun || !raysG) return;
+      const p = Math.min(1, Math.max(0, v));
+      // Size: tiny → peak mid-morning → hold → shrink hard into sunset.
+      const grow = smooth(0.02, 0.28, p);
+      const hold = 1 - smooth(0.55, 0.88, p);
+      const size = Math.max(0.12, grow * hold);
+      const r = (42 + 38 * size) * (1 + 0.01 * Math.sin(animT * 1.2));
+      // Path stays high in the open sky (behind buildings in z-order, but not buried under roofs).
+      // Peak ~180 — same band as the reel's original SUN.y=230 — so it stays readable.
+      const x = 420 + 980 * p;
+      const rise = Math.sin(Math.PI * Math.min(1, Math.max(0, p)));
+      const yBase = 380 - 260 * rise; // morning ~380, noon ~120
+      const sink = smooth(0.72, 1, p);
+      const y = yBase + 240 * sink + 3 * Math.sin(animT * 1.05); // dusk drops toward skyline, not under the timeline
+      // Glow only after it has grown a bit; fade again as it sinks.
+      const glow = smooth(0.12, 0.32, p) * (1 - smooth(0.7, 0.95, p));
+      const sunVis = (0.7 + 0.3 * grow) * (1 - smooth(0.92, 1, p));
+      sun.setAttribute('transform', `translate(${x.toFixed(2)} ${y.toFixed(2)})`);
+      sun.setAttribute('r', r.toFixed(2));
+      sun.style.opacity = String(Math.round(sunVis * 100) / 100);
+      const lines = raysG.querySelectorAll('line');
+      const r0 = r + 14;
+      const r1 = r0 + 18 + 16 * glow;
+      lines.forEach((ln, i) => {
+        const a = (i / 12) * Math.PI * 2 + animT * 0.14;
+        const c = Math.cos(a);
+        const s = Math.sin(a);
+        ln.setAttribute('x1', (x + c * r0).toFixed(2));
+        ln.setAttribute('y1', (y + s * r0).toFixed(2));
+        ln.setAttribute('x2', (x + c * r1).toFixed(2));
+        ln.setAttribute('y2', (y + s * r1).toFixed(2));
+        ln.setAttribute('stroke-width', String(6 + 4 * glow));
+        (ln as SVGElement).style.opacity = String(Math.round(glow * sunVis * 100) / 100);
+      });
+      raysG.style.opacity = String(Math.round(glow * 100) / 100);
+      if (moonRef.current) {
+        const mx = 82 - 68 * p;
+        const narrow = window.innerWidth < 600;
+        const my = narrow ? 9 + 2 * p - 5 * Math.sin(Math.PI * p) : 27 + 4 * p - 21 * Math.sin(Math.PI * p);
+        moonRef.current.style.transform = `translate3d(${mx.toFixed(2)}vw,${my.toFixed(2)}vh,0) translate(-50%,-50%) scale(.72)`;
+        moonRef.current.style.opacity = String(smooth(0.9, 0.98, p));
+      }
+    };
+
+    const paint = (v: number) => {
+      const { sky, night } = skyFor(v);
+      if (skyRef.current) skyRef.current.style.background = sky;
+      if (starsRef.current) starsRef.current.style.opacity = String(Math.round(night * 0.85 * 100) / 100);
+      driveSun(v, sunAnimT.current);
+    };
+
+    const setP = (v: number) => {
+      const p = Math.min(1, Math.max(0, v));
+      progress.current = p;
+      const minute = 540 + Math.round(p * 540);
+      let seg = 0;
+      for (let i = 0, at = 0; i < DUR.length; i += 1) {
+        if (p * TOTAL >= at - 1e-6) seg = i;
+        at += DUR[i];
+      }
+      if (!trackWidth.current && tracksRef.current) trackWidth.current = tracksRef.current.clientWidth;
+      if (playheadRef.current) playheadRef.current.style.transform = `translateX(${p * trackWidth.current}px)`;
+      if (tipRef.current) {
+        tipRef.current.style.transform = p < 0.08 ? 'translateX(0)' : p > 0.92 ? 'translateX(-100%)' : 'translateX(-50%)';
+        tipRef.current.textContent = `${pad2(Math.floor(minute / 60))}:${pad2(minute % 60)} ${namesRef.current[seg]}`;
+      }
+      if (minute !== lastMinute) {
+        lastMinute = minute;
+        if (clockRef.current) clockRef.current.textContent = `${pad2(Math.floor(minute / 60))}:${pad2(minute % 60)}`;
+        tracksRef.current?.setAttribute('aria-valuenow', String(minute));
+        tracksRef.current?.setAttribute('aria-valuetext', `${pad2(Math.floor(minute / 60))}:${pad2(minute % 60)} ${namesRef.current[seg]}`);
+      }
+      if (seg !== lastSeg) {
+        lastSeg = seg;
+        clipRefs.current.forEach((clip, i) => clip.classList.toggle('on', i <= seg));
+      }
+      paint(p);
+    };
+    applyProgressRef.current = setP;
+
+    const frame = (now: number) => {
+      if (document.hidden || rootRef.current?.hidden) { lastNow = now; raf = requestAnimationFrame(frame); return; }
+      const raw = lastNow ? (now - lastNow) / 1000 : 0;
+      const dt = lastNow ? Math.min(0.05, raw) : 0;
+      lastNow = now;
+      // Ray spin / sun bob keep running; day clock only advances while playing.
+      sunAnimT.current += dt;
+      if (playingRef.current) {
+        let p = progress.current + dt / DAY_SECONDS;
+        if (p >= 1) { p -= 1; if (sceneRef.current) sceneRef.current.style.opacity = '1'; }
+        setP(p);
+      } else {
+        driveSun(progress.current, sunAnimT.current);
+      }
+      raf = requestAnimationFrame(frame);
+    };
+
+    let reduced = false;
+    try { reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch { /* ignore */ }
