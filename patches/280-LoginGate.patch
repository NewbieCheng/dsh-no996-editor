+      ));
+      setCaptcha({
+        open: true,
+        id: data.id,
+        prompt: data.prompt || '',
+        sequence: Array.isArray(data.sequence) ? data.sequence : [],
+        hint: promptHint(t, data.prompt || '', data.icon_target),
+        svg,
+        error: '',
+        clicks: [],
+        wrong: 0,
+        marks: [],
+      });
+    } catch (error) {
+      setCaptcha(was => ({ ...was, error: (error as Error).message || t('login.captchaLoadFailed') }));
+    }
+  };
+
+  const closeCaptcha = () => {
+    pending.current = '';
+    setCaptcha(was => ({ ...was, open: false, id: '', clicks: [], marks: [], error: '' }));
+  };
+
+  const finishCaptcha = (codeValue?: string) => {
+    const kind = pending.current;
+    const id = captcha.id;
+    closeCaptcha();
+    if (kind === 'login') void runLogin(id, codeValue);
+    else if (kind === 'otp') void runOtp(id, codeValue);
+  };
+
+  const runLogin = async (id: string, codeValue?: string) => {
+    setBusy(true);
+    try {
+      await auth('login', { account: account.trim(), password, captchaId: id, captchaCode: codeValue });
+      await saveRemember();
+      afterLogin();
+    } catch (error) {
+      problem((error as Error).message || t('login.loginFailed'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const runOtp = async (id: string, codeValue?: string) => {
+    setBusy(true);
+    try {
+      await auth('verification-code', {
+        account: account.trim(),
+        purpose: mode === 'reset' ? 'reset_password' : 'register',
+        captchaId: id,
+        captchaCode: codeValue,
+      });
+      note(t('login.codeSent'));
+      setOtpWait(60);
+      const timer = window.setInterval(() => {
+        setOtpWait(was => {
+          if (was <= 1) { window.clearInterval(timer); return 0; }
+          return was - 1;
+        });
+      }, 1000);
+    } catch (error) {
+      problem((error as Error).message || t('login.codeSendFailed'));
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const onCaptchaClick = (event: React.MouseEvent<HTMLDivElement>) => {
+    const stage = event.currentTarget;
+    const target = (event.target as HTMLElement).closest?.('[data-captcha-id]') as HTMLElement | null;
+    if (!target || !captcha.id) return;
+    const id = target.getAttribute('data-captcha-id');
+    const kind = target.getAttribute('data-captcha-kind') || '';
+    if (!id) return;
+    const stageRect = stage.getBoundingClientRect();
+    const rect = target.getBoundingClientRect();
+    const mark = {
+      x: rect.left - stageRect.left + rect.width / 2,
+      y: rect.top - stageRect.top + rect.height / 2,
+      n: 1,
+    };
+    if (!isSequence(captcha.prompt)) {
+      setCaptcha(was => ({ ...was, marks: [mark] }));
+      window.setTimeout(() => finishCaptcha(id), 180);
+      return;
+    }
+    const clicks = captcha.clicks;
+    if (clicks.includes(id)) return;
+    if (captcha.prompt === 'click_sequence') {
+      const expected = captcha.sequence[clicks.length];
+      if (expected && kind !== expected) {
+        const wrong = captcha.wrong + 1;
+        if (wrong >= 2) {
+          setCaptcha(was => ({ ...was, wrong, error: t('login.captchaWrongMany'), clicks: [], marks: [] }));
+          void loadCaptcha();
+        } else {
+          setCaptcha(was => ({ ...was, wrong, error: t('login.captchaWrongOrder'), clicks: [], marks: [] }));
+        }
+        return;
+      }
+    }
+    const next = [...clicks, id];
+    const expectedSteps = captcha.prompt === 'click_sequence' ? (captcha.sequence.length || 1) : isSequence(captcha.prompt) ? 4 : 1;
+    setCaptcha(was => ({ ...was, clicks: next, marks: [...was.marks, { ...mark, n: next.length }], error: '' }));
+    if (next.length >= expectedSteps) window.setTimeout(() => finishCaptcha(next.join(',')), 220);
+  };
+
+  const submit = (event: React.FormEvent) => {
+    event.preventDefault();
+    if (busy || captcha.open) return;
+    const acc = account.trim();
+    if (!acc) return problem(mode === 'login' ? t('login.needAccountPhoneEmail') : t('login.needEmail'));
+    if (mode === 'login') {
+      if (password.length < 6) return problem(t('login.passwordTooShortRetry'));
+      openCaptcha('login');
+      return;
+    }
+    if (mode === 'register') {
+      if (!acc.includes('@')) return problem(t('login.registerNeedEmail'));
+      if (password.length < 6) return problem(t('login.passwordTooShort'));
+      if (!code.trim()) return problem(t('login.needEmailCode'));
+      if (!invite.trim()) return problem(t('login.needInvite'));
+      setBusy(true);
+      void auth('register', { account: acc, password, code: code.trim(), inviteCode: invite.trim(), displayName: displayName.trim() || undefined })
+        .then(afterLogin)
+        .catch(error => problem((error as Error).message || t('login.registerFailed')))
+        .finally(() => setBusy(false));
+      return;
+    }
+    if (!acc.includes('@')) return problem(t('login.resetNeedEmail'));
+    if (!code.trim()) return problem(t('login.needEmailCode'));
+    if (password.length < 6) return problem(t('login.newPasswordTooShort'));
+    setBusy(true);
+    void auth('reset-password', { account: acc, code: code.trim(), newPassword: password })
+      .then(() => { setMode('login'); note(t('login.passwordUpdated')); setCode(''); })
+      .catch(error => problem((error as Error).message || t('login.resetFailed')))
+      .finally(() => setBusy(false));
+  };
+
+  const seekTo = (clientX: number) => {
+    const tracks = tracksRef.current;
+    if (!tracks) return;
+    const rect = tracks.getBoundingClientRect();
+    if (!rect.width) return;
+    const p = Math.min(1, Math.max(0, (clientX - rect.left) / rect.width));
+    // Full paint path: sky / sun / clock follow the scrubbed time (does not pause).
+    applyProgressRef.current(p);
+  };
+
+  const onTracksKey = (event: React.KeyboardEvent) => {
+    const step = ({ ArrowLeft: -0.04, ArrowDown: -0.04, ArrowRight: 0.04, ArrowUp: 0.04 } as Record<string, number>)[event.key];
+    if (step != null) seekTo(0 + (progress.current + step) * (trackWidth.current || 1) + (tracksRef.current?.getBoundingClientRect().left ?? 0));
+    else if (event.key === 'Home') seekTo(tracksRef.current?.getBoundingClientRect().left ?? 0);
+    else if (event.key === 'End') seekTo((tracksRef.current?.getBoundingClientRect().right ?? 0));
+    else return;
+    event.preventDefault();
+  };
+
+  const otpDisabled = busy || otpWait > 0;
+  const asideText = message || (mode === 'login' ? t('login.asideLogin') : '');
+  const goLabel = mode === 'login' ? t('login.submitLogin') : mode === 'register' ? t('login.submitRegister') : t('login.submitReset');
+
+  const ambientStill = !playing || captcha.open;
+  const rootClass = [
+    'nof-lg',
+    ambientStill ? 'is-still' : '',
+    raining ? 'is-rain' : '',
+    scrubbing ? 'is-scrub' : '',
+    cardOpen ? '' : 'is-card-closed',
+  ].filter(Boolean).join(' ');
+
+  return (
+    <div ref={rootRef} id="no996-shell-login" className={rootClass} role="dialog" aria-label={t('login.aria')}>
+      <div ref={sceneRef} className="lg-scene" aria-hidden="true">
+        <div className="lg-city">
+          <div className="lg-city-pan">
+            <svg ref={cityRef} viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice" focusable="false" />
+          </div>
+        </div>
+        <div ref={skyRef} className="lg-sky"><i ref={starsRef} className="stars" /></div>
+        <div className="lg-ambient" aria-hidden="true">
+          <i className="lg-cloud c1" />
+          <i className="lg-cloud c2" />
+          <i className="lg-cloud c3" />
+          <i className="lg-tree t1" />
+          <i className="lg-tree t2" />
+          <i className="lg-tree t3" />
+          <i className="lg-car car1" />
+          <i className="lg-car car2" />
+          <i className="lg-bus" />
+          <div className="lg-rain" aria-hidden="true">
+            {Array.from({ length: 28 }, (_, i) => <i key={i} style={{ left: `${(i * 37) % 100}%`, animationDelay: `${-i * 0.17}s`, animationDuration: `${0.7 + (i % 5) * 0.12}s` }} />)}
+          </div>
+        </div>
+        <div ref={moonRef} className="lg-orb moon" aria-hidden="true" />
+      </div>
+
+      <header className="lg-brand">
+        <span className="lg-mark" aria-hidden="true" dangerouslySetInnerHTML={{ __html: BRAND_WHITE }} />
+        <b>{t('login.brandName')}</b>
+        <span>{t('login.brandTag')}</span>
+      </header>
+
+      {!cardOpen ? (
+        <button type="button" className="lg-open-card" onClick={() => setCardOpen(true)}>
+          {t('login.startLogin')}
+        </button>
+      ) : null}
+
+      <main className="lg-main" hidden={!cardOpen}>
+        <form id="nof-form" className="lg-card" noValidate onSubmit={submit}>
+          <button type="button" className="lg-card-close" aria-label={t('login.hideCardAria')} title={t('login.hideCard')} onClick={() => setCardOpen(false)}>×</button>
+          <i className="lg-tape" aria-hidden="true" />
+          <div className="lg-punch"><span>{t('login.punch')}</span><time ref={clockRef}>09:00</time></div>
+          <h1>{mode === 'login' ? t('login.greetLogin') : mode === 'register' ? t('login.greetRegister') : t('login.greetReset')}</h1>
+          <p className="lg-sub">{mode === 'login' ? t('login.subLogin') : mode === 'register' ? t('login.subRegister') : t('login.subReset')}</p>
+
+          <label className="lg-field">
+            <span className="lg-lab">{mode === 'login' ? t('login.account') : t('login.email')}</span>
+            <span className="lg-f">
+              <input
+                autoComplete="username" autoCapitalize="none" spellCheck={false}
+                placeholder={mode === 'login' ? t('login.accountPlaceholder') : 'name@example.com'}
+                value={account} onChange={event => setAccount(event.target.value)}
+              />
+            </span>
+          </label>
+
+          {mode === 'register' && (
+            <label className="lg-field">
+              <span className="lg-lab">{t('login.nickname')}</span>
+              <span className="lg-f"><input autoComplete="nickname" placeholder={t('login.nicknamePlaceholder')} value={displayName} onChange={event => setDisplayName(event.target.value)} /></span>
+            </label>
+          )}
+
+          {mode !== 'login' && (
+            <div className="lg-row">
+              <label className="lg-field">
+                <span className="lg-lab">{t('login.emailCode')}</span>
+                <span className="lg-f"><input inputMode="numeric" autoComplete="one-time-code" placeholder={t('login.codePlaceholder')} value={code} onChange={event => setCode(event.target.value)} /></span>
+              </label>
+              <button type="button" className="lg-otp" disabled={otpDisabled} onClick={() => {
+                if (busy || otpWait > 0) return;
+                if (!account.trim().includes('@')) return problem(t('login.needEmailFirst'));
+                openCaptcha('otp');
+              }}>{otpWait > 0 ? otpWait + 's' : t('login.sendCode')}</button>
+            </div>
+          )}
+
+          {mode === 'register' && (
+            <label className="lg-field">
+              <span className="lg-lab">{t('login.invite')}</span>
+              <span className="lg-f"><input autoComplete="off" placeholder={t('login.invitePlaceholder')} value={invite} onChange={event => setInvite(event.target.value)} /></span>
+            </label>
+          )}
+
+          <label className="lg-field">
+            <span className="lg-lab">{mode === 'reset' ? t('login.newPassword') : t('login.password')}</span>
+            <span className="lg-f">
+              <input
+                type={showPassword ? 'text' : 'password'}
+                autoComplete={mode === 'login' ? 'current-password' : 'new-password'}
+                placeholder={t('login.passwordPlaceholder')} value={password} onChange={event => setPassword(event.target.value)}
+              />
+              <button type="button" className="lg-eye" aria-label={showPassword ? t('login.hidePasswordAria') : t('login.showPasswordAria')} aria-pressed={showPassword} onClick={() => setShowPassword(v => !v)}>
+                {showPassword ? t('login.hidePassword') : t('login.showPassword')}
+              </button>
+            </span>
+          </label>
+
+          <div className="lg-meta">
+            {mode === 'login' && (
+              <label className="lg-remember">
+                <input type="checkbox" checked={remember} onChange={event => setRemember(event.target.checked)} />
+                <span>{t('login.remember')}</span>
+              </label>
+            )}
+            <div className="lg-links">
+              <button type="button" className="lg-lk" onClick={() => setMode(mode === 'login' ? 'reset' : 'login')}>
+                {mode === 'login' ? t('login.forgotPassword') : t('login.backToLogin')}
+              </button>
+              <button type="button" className="lg-lk" onClick={() => setMode(mode === 'register' ? 'login' : 'register')}>
+                {mode === 'login' ? t('login.register') : t('login.goLogin')}
+              </button>
+            </div>
+          </div>
+
+          <button type="submit" className="lg-go" disabled={busy}>{goLabel}</button>
+          {accountPrompt ? (
+            <button type="button" className="lg-go-guest" disabled={busy} onClick={leavePreview}>{t('login.backWorkbench')}</button>
+          ) : mode === 'login' ? (
+            <button type="button" className="lg-go-guest" disabled={busy} onClick={() => void enterGuest()}>
+              {t('login.guestEnter')}
+            </button>
+          ) : null}
+          <p className={isError ? 'lg-msg err' : 'lg-msg'} role="status" aria-live="polite">{asideText}</p>
+          <div className="lg-stamp" aria-hidden="true">{t('login.stampLine1')}<br />{t('login.stampLine2')}</div>
+        </form>
+      </main>
+
+      <div className="lg-tl">
+        <div className="lg-ruler" aria-hidden="true">
+          {Array.from({ length: 10 }, (_, i) => 9 + i).map(hour => (
+            <i key={hour} style={{ left: `${((hour - 9) / 9) * 100}%` }}><b>{hour}</b></i>
+          ))}
+        </div>
+        <button type="button" className="lg-play" aria-label={playing ? t('login.pause') : t('login.play')} title={playing ? t('login.pause') : t('login.play')} onClick={() => setPlaying(v => !v)}>
+          <span style={{ display: 'contents' }} dangerouslySetInnerHTML={{ __html: playing ? PAUSE_ICON : PLAY_ICON }} />
+        </button>
+        <div
+          ref={tracksRef}
+          className={`lg-tracks${scrubbing ? ' drag' : ''}`} role="slider" tabIndex={0}
+          aria-label={t('login.timelineAria')}
+          aria-valuemin={540} aria-valuemax={1080} aria-valuenow={540} aria-valuetext={`09:00 ${names[0]}`}
+          onPointerDown={event => {
+            // Scrub without pausing — play button alone owns play/pause.
+            setScrubbing(true);
+            try { event.currentTarget.setPointerCapture(event.pointerId); } catch { /* ignore */ }
+            seekTo(event.clientX);
+          }}
+          onPointerMove={event => { if (scrubbing || event.buttons === 1) seekTo(event.clientX); }}
+          onPointerUp={() => setScrubbing(false)}
+          onPointerCancel={() => setScrubbing(false)}
+          onKeyDown={onTracksKey}
+        >
+          <div className="lg-clips">
+            {names.map((name, i) => (
+              <div key={DAY_KEYS[i]} ref={node => { if (node) clipRefs.current[i] = node; }} className="lg-clip" style={{ flex: String(DUR[i]) }}>{name}</div>
+            ))}
+          </div>
+          <div ref={playheadRef} className="lg-playhead">
+            <div className="lg-grip"><span ref={tipRef} className="lg-tip">{`09:00 ${names[0]}`}</span></div>
+          </div>
+        </div>
+      </div>
+
+      <div className="lg-vig" aria-hidden="true" />
+
+      {captcha.open && (
+        <div className="cap-mask" role="presentation">
+          <div className={`cap${captcha.error ? ' is-err' : ''}`} role="dialog" aria-modal="true" aria-label={t('login.captchaAria')}>
+            <header className="cap-head">
+              <h2>{t('login.captchaTitle')}</h2>
+              <p className="hint">{captcha.hint}</p>
+              {captcha.prompt === 'click_sequence' && captcha.sequence.length > 0 ? (
+                <ol className="cap-seq" aria-label={t('login.captchaSequence')}>
+                  {captcha.sequence.map((kind, i) => {
+                    const state = captcha.clicks.length > i ? 'done' : captcha.clicks.length === i ? 'next' : '';
+                    return (
+                      <li key={`${kind}-${i}`} className={state || undefined} aria-current={state === 'next' ? 'step' : undefined}>
+                        <span className="n">{i + 1}</span>
+                        <span className="lab">{iconLabel(t, kind)}</span>
+                      </li>
+                    );
+                  })}
+                </ol>
+              ) : null}
+            </header>
+            <div className="stage" onClick={onCaptchaClick}>
+              {captcha.svg ? (
+                <div className="stage-board" dangerouslySetInnerHTML={{ __html: captcha.svg }} />
+              ) : (
+                <div className="stage-empty">{captcha.error ? t('login.captchaLoadRetry') : t('login.captchaLoading')}</div>
+              )}
+              {captcha.marks.map((mark, i) => (
+                <span key={i} className="pick" style={{ left: mark.x, top: mark.y }}>{mark.n}</span>
+              ))}
+            </div>
+            {captcha.error ? <p className="err" role="alert">{captcha.error}</p> : null}
+            <footer className="acts">
+              <button type="button" className="refresh" onClick={() => void loadCaptcha()}>{t('login.captchaRefresh')}</button>
+              <button type="button" className="cancel" onClick={closeCaptcha}>{t('login.captchaCancel')}</button>
+            </footer>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+}
