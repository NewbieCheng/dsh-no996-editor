+    setPlaying(!reduced);
+    setP(0);
+    raf = requestAnimationFrame(frame);
+    mountCity();
+    const onResize = () => { trackWidth.current = tracksRef.current?.clientWidth ?? 0; };
+    window.addEventListener('resize', onResize);
+    return () => {
+      cancelAnimationFrame(raf);
+      window.removeEventListener('resize', onResize);
+      applyProgressRef.current = () => {};
+    };
+  }, []);
+
+  // Occasional short rain — subtle, never fights the login card.
+  React.useEffect(() => {
+    if (!visible) return;
+    let cancelled = false;
+    let rainTimer = 0;
+    let waitTimer = 0;
+    const schedule = () => {
+      const waitMs = 28000 + Math.random() * 52000;
+      waitTimer = window.setTimeout(() => {
+        if (cancelled) return;
+        setRaining(true);
+        rainTimer = window.setTimeout(() => {
+          if (cancelled) return;
+          setRaining(false);
+          schedule();
+        }, 7000 + Math.random() * 8000);
+      }, waitMs);
+    };
+    schedule();
+    return () => {
+      cancelled = true;
+      window.clearTimeout(waitTimer);
+      window.clearTimeout(rainTimer);
+      setRaining(false);
+    };
+  }, [visible]);
+
+  React.useEffect(() => {
+    const openPreview = () => { setMode('login'); setAccountPrompt(true); setVisible(true); };
+    const syncGate = () => {
+      if (isLoginPreview()) { openPreview(); return; }
+      void rpc('auth:status').then((data: { loggedIn?: boolean }) => setVisible(data?.loggedIn !== true)).catch(() => setVisible(true));
+    };
+    const openAccountLogin = () => { openPreview(); };
+    syncGate();
+    window.addEventListener('no996-auth-changed', syncGate);
+    window.addEventListener('no996-open-account-login', openAccountLogin);
+    window.addEventListener('popstate', syncGate);
+    void rpc('auth:remember-get').then((data: { enabled?: boolean; account?: string; password?: string }) => {
+      if (!data?.enabled || !data.account) return;
+      setAccount(String(data.account).slice(0, 160));
+      if (data.password) setPassword(String(data.password).slice(0, 128));
+      setRemember(true);
+    }).catch(() => {});
+    return () => {
+      window.removeEventListener('no996-auth-changed', syncGate);
+      window.removeEventListener('no996-open-account-login', openAccountLogin);
+      window.removeEventListener('popstate', syncGate);
+    };
+  }, []);
+
+  React.useEffect(() => {
+    playingRef.current = playing;
+  }, [playing]);
+
+  if (!visible) return null;
+
+  const afterLogin = () => {
+    setAccountPrompt(false);
+    setPlaying(false);
+    setProgressEnd();
+    setVisible(false);
+    clearLoginPreview();
+    try { window.dispatchEvent(new CustomEvent('no996-auth-changed', { detail: { loggedIn: true } })); } catch { /* ignore */ }
+    try {
+      if (window.parent !== window) window.parent.postMessage({ type: 'no996-openfilm:auth', version: 1, action: 'logged-in' }, '*');
+    } catch { /* ignore */ }
+  };
+
+  const leavePreview = () => {
+    setAccountPrompt(false);
+    setVisible(false);
+    clearLoginPreview();
+  };
+
+  const enterGuest = async () => {
+    setBusy(true);
+    try {
+      await auth('guest', {});
+      afterLogin();
+    } catch (error) {
+      problem((error as Error).message || t('login.guestFailed'));
+    } finally {
+      setBusy(false);
+    }
+  };
+  function setProgressEnd() {
+    progress.current = 1;
+    if (playheadRef.current && tracksRef.current) playheadRef.current.style.transform = `translateX(${tracksRef.current.clientWidth}px)`;
+  }
+
+  const saveRemember = async () => {
+    if (mode !== 'login') return;
+    if (!remember) { await rpc('auth:remember-clear').catch(() => {}); return; }
+    await rpc('auth:remember-set', { account: account.trim(), password, enabled: true }).catch(() => {});
+  };
+
+  const openCaptcha = (kind: 'login' | 'otp') => {
+    pending.current = kind;
+    setCardOpen(true);
+    setCaptcha({ open: true, id: '', prompt: '', sequence: [], hint: t('login.captchaDefault'), svg: '', error: '', clicks: [], wrong: 0, marks: [] });
