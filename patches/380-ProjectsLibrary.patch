+  async function copyNo996Template(templateId: string) {
+    if (busy) return;
+    setBusy('creating');
+    try {
+      const response = await fetch('/__dsh/official-rpc', {
+        method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' },
+        body: JSON.stringify({ channel: 'template:create', payload: { templateId } }),
+      });
+      if (!response.ok) throw new Error(`HTTP ${response.status}`);
+      const result = await response.json() as { projectId?: string; error?: string; warnings?: string[] };
+      if (!result.projectId || !/^[A-Za-z0-9_-]{6,40}$/.test(result.projectId)) throw new Error(result.error || 'Missing project ID');
+      // NO996-UPSTREAM: the copy exists even if recording its template/prefs failed.
+      // Warn before navigating rather than encouraging a second copy.
+      if (result.warnings?.length) {
+        const zh = document.documentElement.lang.toLowerCase().startsWith('zh');
+        window.alert(result.warnings.includes('TEMPLATE_ACTIVATION_FAILED')
+          ? (zh ? '项目已创建，但模板说明未能自动启用。请在对话中读取所选模板说明。' : 'The project was created, but its template guidance was not activated. Read the template guidance in chat.')
+          : (zh ? '项目已创建，但未能保存最近使用的偏好。' : 'The project was created, but recent preferences could not be saved.'));
+      }
+      go(result.projectId, 'creating');
+    } catch {
+      setBusy(null);
+      // A lost response may follow successful registration; never imply it is safe
+      // to create again before checking the project list.
+      lib.flash(document.documentElement.lang.toLowerCase().startsWith('zh')
+        ? '无法确认创建结果，请先到「我的项目」检查，再决定是否重试。'
+        : 'Creation could not be confirmed. Check My Projects before trying again.');
+    }
+  }
