+import React from 'react';
+import { createPortal } from 'react-dom';
+import { ArrowRight, Sparkles, X } from 'lucide-react';
+
+const COPY = {
+  zh: { title: '0.22.0 · 从一支片，到一套创作系统', intro: '这次把续聊、双比例模板、口播拆解和品牌记忆连成了一条流程。', notes: ['刷新或断线后，回到原对话和原影片，不重发。', '四套示例都有竖屏／横屏独立布局，文字和图解继续可改。', 'Vibe 支持口播分镜、配乐开关与实测卡点。', '项目标题菜单可把选中镜头存成本地模板；分享包默认不带私人品牌和配乐。'], done: '开始创作' },
+  en: { title: '0.22.0 · A complete creation flow', intro: 'Resume, dual-canvas templates, script planning and brand memory now work together.', notes: ['Refresh or reconnect returns to the exact conversation and film without resending.', 'All four templates have independent portrait and landscape layouts with editable text and diagrams.', 'Vibe adds script breakdown, music choices and measured beat accents.', 'Save selected scenes as local templates from the project title menu; share ZIPs omit private brand and music by default.'], done: 'Start creating' },
+};
+
+async function rpc<T>(channel: string, payload: unknown): Promise<T> {
+  const response = await fetch('/__dsh/official-rpc', { method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ channel, payload }) });
+  if (!response.ok) throw new Error('Update introduction unavailable');
+  return response.json();
+}
+
+export function No996WhatsNew() {
+  const [version, setVersion] = React.useState('');
+  const [open, setOpen] = React.useState(false);
+  const [busy, setBusy] = React.useState(false);
+  const language = document.documentElement.lang.toLowerCase().startsWith('zh') ? 'zh' : 'en';
+  const copy = COPY[language];
+  React.useEffect(() => {
+    let live = true;
+    void Promise.all([rpc<{ version: string }>('client:version', {}), rpc<{ prefs: { no996UpdateVersion?: string } }>('prefs:get', {})]).then(([current, prefs]) => {
+      if (live && current.version && prefs.prefs.no996UpdateVersion !== current.version) { setVersion(current.version); setOpen(true); }
+    }).catch(() => { /* An update intro must never block the editor. */ });
+    return () => { live = false; };
+  }, []);
+  const close = React.useCallback(async () => {
+    if (busy || !version) return;
+    setBusy(true);
+    try { await rpc('prefs:set', { no996UpdateVersion: version }); setOpen(false); }
+    catch { setBusy(false); }
+  }, [busy, version]);
+  React.useEffect(() => {
+    if (!open) return undefined;
+    const key = (event: KeyboardEvent) => { if (event.key === 'Escape') { event.preventDefault(); void close(); } };
+    window.addEventListener('keydown', key, true);
+    return () => window.removeEventListener('keydown', key, true);
+  }, [open, close]);
+  if (!open) return null;
+  return createPortal(<div className="fixed inset-0 z-[10200] grid place-items-center bg-black/50 p-5 backdrop-blur-[2px]" role="dialog" aria-modal="true" aria-labelledby="no996-update-title">
+    <section className="max-h-[90vh] w-[min(620px,95vw)] overflow-y-auto rounded-2xl border border-[var(--border)] bg-[var(--bg-raised)] p-6 shadow-2xl">
+      <header className="flex items-start justify-between gap-4"><div><p className="flex items-center gap-2 text-xs font-semibold text-[var(--text-muted)]"><Sparkles size={14} />No996 Editor {version}</p><h2 id="no996-update-title" className="mt-2 text-xl font-semibold">{copy.title}</h2><p className="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{copy.intro}</p></div><button type="button" aria-label={language === 'zh' ? '关闭更新介绍' : 'Close update introduction'} disabled={busy} onClick={() => void close()} className="rounded p-1 hover:bg-[var(--bg-hover)]"><X size={18} /></button></header>
+      <ul className="my-5 space-y-3">{copy.notes.map(note => <li key={note} className="flex gap-3 text-sm leading-relaxed"><span className="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]" />{note}</li>)}</ul>
+      <button type="button" disabled={busy} onClick={() => void close()} className="flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--accent)] px-4 py-2.5 text-sm font-semibold text-[var(--text)] disabled:opacity-50">{busy ? (language === 'zh' ? '正在保存…' : 'Saving…') : copy.done}<ArrowRight size={15} /></button>
+    </section>
+  </div>, document.body);
+}
