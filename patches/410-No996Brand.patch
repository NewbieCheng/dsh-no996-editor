+import React from 'react';
+
+type Corner = 'top-left' | 'top-right' | 'bottom-left' | 'bottom-right';
+type Position = Corner | 'auto';
+type Settings = { enabled: boolean; name: string; identity: string; placement: Position; logoBase64: string | null; configured?: boolean };
+type LogoChoice = 'default' | 'upload' | 'none';
+type ProjectBrand = { profileEnabled?: boolean; logoPlaced: boolean; brand: { name: string; placement: Corner; logo: string | null } | null };
+const field = 'w-full rounded-md border border-[var(--border)] bg-[var(--bg-field)] px-2.5 py-1.5 text-sm text-[var(--text)]';
+const button = 'rounded-md border border-[var(--border)] px-2.5 py-1.5 text-xs font-semibold hover:bg-[var(--bg-hover)] disabled:opacity-50';
+const isZh = () => document.documentElement.lang.toLowerCase().startsWith('zh');
+const corners: Array<[Corner, string, string]> = [
+  ['top-left', '左上', 'Top left'], ['top-right', '右上', 'Top right'],
+  ['bottom-left', '左下', 'Bottom left'], ['bottom-right', '右下', 'Bottom right'],
+];
+
+async function request<T>(channel: string, payload: unknown, signal?: AbortSignal): Promise<T> {
+  const response = await fetch('/__dsh/official-rpc', { method: 'POST', credentials: 'same-origin',
+    headers: { 'content-type': 'application/json' }, body: JSON.stringify({ channel, payload }), signal });
+  if (!response.ok) throw new Error('Brand settings unavailable');
+  return response.json();
+}
+
+function PositionOptions({ zh, auto }: { zh: boolean; auto?: boolean }) {
+  return <>{auto ? <option value="auto">{zh ? '自动安全区' : 'Automatic safe area'}</option> : null}
+    {corners.map(([value, cn, en]) => <option key={value} value={value}>{zh ? cn : en}</option>)}</>;
+}
+
+function readLogo(file: File): Promise<string> {
+  if (!file.size || file.size > 2 * 1024 * 1024) return Promise.reject(new Error('PNG too large'));
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result).split(',')[1] ?? '');
+    reader.onerror = reader.onabort = reject;
+    reader.readAsDataURL(file);
+  });
+}
+
+export function No996BrandSettings({ projectId }: { projectId?: string } = {}) {
+  const zh = isZh();
+  const [settings, setSettings] = React.useState<Settings>();
+  const [defaultLogo, setDefaultLogo] = React.useState('');
+  const [choice, setChoice] = React.useState<LogoChoice>('default');
+  const [retry, setRetry] = React.useState(0);
+  const [savedRevision, setSavedRevision] = React.useState(0);
+  const [busy, setBusy] = React.useState(false);
+  const [notice, setNotice] = React.useState('');
+  React.useEffect(() => {
+    const task = new AbortController();
+    void request<{ settings: Settings; defaultLogoBase64: string }>('brand:settings-get', {}, task.signal).then(({ settings: saved, defaultLogoBase64 }) => {
+      if (task.signal.aborted) return;
+      setDefaultLogo(defaultLogoBase64);
+      setSettings(saved.configured ? saved : { ...saved, enabled: true });
+      setChoice(!saved.configured || saved.logoBase64 === defaultLogoBase64 ? 'default' : saved.logoBase64 ? 'upload' : 'none');
+    }).catch(() => { if (!task.signal.aborted) setNotice(zh ? '无法读取品牌设置，请重试。' : 'Brand settings could not be loaded. Try again.'); });
+    return () => task.abort();
+  }, [zh, retry]);
+  const update = (patch: Partial<Settings>) => { setNotice(''); setSettings(previous => previous ? { ...previous, ...patch } : previous); };
+  async function choose(file: File | undefined) {
+    if (!file) return;
+    setBusy(true);
+    try {
+      const bytes = await readLogo(file);
+      if (!bytes.startsWith('iVBORw0KGgo')) throw new Error('Not a PNG');
+      update({ logoBase64: bytes });
+      setChoice('upload');
+    }
+    catch { setNotice(zh ? '请选择不超过 2 MB 的 PNG。' : 'Choose a PNG up to 2 MiB.'); }
+    finally { setBusy(false); }
+  }
+  async function save(skip = false) {
+    if (busy || !settings || (!skip && choice === 'upload' && (!settings.logoBase64 || settings.logoBase64 === defaultLogo))) return;
+    setBusy(true);
+    try {
+      const result = await request<{ settings: Settings }>('brand:settings-save', {
+        enabled: !skip && settings.enabled, name: skip ? '' : settings.name, identity: skip ? '' : settings.identity,
+        placement: skip ? 'auto' : settings.placement,
+        logoBase64: !skip && choice === 'upload' ? settings.logoBase64 : null, useDefaultLogo: !skip && choice === 'default',
+      });
+      setSettings(result.settings);
+      setSavedRevision(value => value + 1);
+      if (skip) setChoice('none');
+      setNotice(skip ? (zh ? '已跳过，随时可回来配置。' : 'Skipped. You can set up your brand here any time.')
+        : (zh ? '品牌默认值已保存，不会改动已有影片。' : 'Brand defaults saved. Existing films are unchanged.'));
+    } catch { setNotice(zh ? '品牌设置未保存，请重试。若仍失败，请查看诊断日志。' : 'Brand settings were not saved. Try again or check diagnostics.'); }
+    finally { setBusy(false); }
+  }
+  if (!settings) return <div className="flex items-center gap-2 py-2"><p role="status" className="text-xs text-[var(--text-muted)]">{notice || (zh ? '正在读取品牌设置…' : 'Loading brand settings…')}</p>{notice ? <button type="button" className={button} onClick={() => { setNotice(''); setRetry(value => value + 1); }}>{zh ? '重试' : 'Retry'}</button> : null}</div>;
+  const uploaded = settings.logoBase64 && settings.logoBase64 !== defaultLogo ? settings.logoBase64 : null;
+  const preview = choice === 'default' ? defaultLogo : choice === 'upload' ? uploaded : null;
+  return <><form aria-label={zh ? '品牌默认值' : 'Brand defaults'} onSubmit={event => { event.preventDefault(); void save(); }} className="space-y-3 py-3 text-sm">
+    {!settings.configured ? <div className="rounded-lg border border-[var(--border)] px-3 py-2.5"><p className="font-semibold">{zh ? '首次设置品牌' : 'Set up your brand'}</p><p className="mt-1 text-xs leading-relaxed text-[var(--text-muted)]">{zh ? '填上你的品牌或创作者名称，再选一个 Logo。可以使用不加班工作台的默认图标，也可以上传自己的。保存后，只有你选择「用于本片」时才会应用到影片。' : 'Enter your brand or creator name, then choose a logo. Use the No996 logo or upload your own. Saving these defaults does not apply them to any film until you choose “Use for this film”.'}</p></div> : null}
+    <label className="flex items-center gap-2"><input type="checkbox" checked={settings.enabled} disabled={busy} onChange={event => update({ enabled: event.target.checked })} />{zh ? '启用品牌默认值' : 'Enable brand defaults'}</label>
+    <label className="block space-y-1"><span>{zh ? '品牌／创作者名称' : 'Brand or creator name'}</span><input className={field} maxLength={80} disabled={busy} value={settings.name} onChange={event => update({ name: event.target.value })} /></label>
+    <label className="block space-y-1"><span>{zh ? '写作身份（不显示在影片里）' : 'Writing identity (not shown in the film)'}</span><textarea className={field} maxLength={600} rows={2} disabled={busy} value={settings.identity} onChange={event => update({ identity: event.target.value })} /></label>
+    <label className="block space-y-1"><span>{zh ? '默认 Logo 位置' : 'Default logo position'}</span><select className={field} value={settings.placement} disabled={busy} onChange={event => update({ placement: event.target.value as Position })}><PositionOptions zh={zh} auto /></select></label>
+    <div className="flex flex-wrap items-end gap-2">
+      {preview ? <img src={`data:image/png;base64,${preview}`} alt={zh ? 'Logo 预览' : 'Logo preview'} className="h-10 w-10 shrink-0 rounded border border-[var(--border)] object-contain" /> : null}
+      <label className="min-w-0 flex-1 space-y-1"><span>{zh ? 'Logo 来源' : 'Logo source'}</span><select className={field} value={choice} disabled={busy} onChange={event => { setNotice(''); setChoice(event.target.value as LogoChoice); }}><option value="default">{zh ? '不加班工作台默认图标' : 'Default No996 logo'}</option><option value="upload">{zh ? '上传我的 Logo' : 'Upload my logo'}</option><option value="none">{zh ? '不使用 Logo' : 'No logo'}</option></select></label>
+      {choice === 'upload' ? <label className="w-full space-y-1"><span>{zh ? '上传 Logo（PNG，最大 2 MB）' : 'Upload logo (PNG, up to 2 MiB)'}</span><input className={field} type="file" accept=".png,image/png" disabled={busy} onChange={event => { void choose(event.target.files?.[0]); event.target.value = ''; }} /></label> : null}
+    </div>
+    <div className="flex flex-wrap items-center justify-between gap-2"><p role="status" className="text-xs text-[var(--text-muted)]">{notice}</p>{!settings.configured ? <button type="button" className={button} disabled={busy} onClick={() => void save(true)}>{zh ? '暂不设置' : 'Skip for now'}</button> : null}<button type="submit" className={button} disabled={busy || (choice === 'upload' && !uploaded)}>{zh ? '保存品牌默认值' : 'Save brand defaults'}</button></div>
+  </form>{projectId && settings.configured ? <ProjectBrandSettings key={projectId} projectId={projectId} savedRevision={savedRevision} /> : null}</>;
+}
+
+function ProjectBrandSettings({ projectId, savedRevision }: { projectId: string; savedRevision: number }) {
+  const zh = isZh();
+  const [open, setOpen] = React.useState(false);
+  const [view, setView] = React.useState<ProjectBrand>();
+  const [notice, setNotice] = React.useState('');
+  const [busy, setBusy] = React.useState(false);
+  const panelId = React.useId();
+  React.useEffect(() => {
+    if (!open) return;
+    const task = new AbortController();
+    void request<ProjectBrand>('brand:project-get', { projectId }, task.signal).then(value => {
+      if (!task.signal.aborted) setView(value);
+    }).catch(() => { if (!task.signal.aborted) setNotice(zh ? '无法读取本片品牌。' : 'Project brand could not be loaded.'); });
+    return () => task.abort();
+  }, [open, projectId, savedRevision, zh]);
+
+  async function apply(mode: 'snapshot' | 'off' | 'placement', placement?: Corner) {
+    if (busy) return;
+    setBusy(true); setNotice('');
+    try {
+      const next = await request<ProjectBrand>('brand:project-set', { projectId, mode, ...(placement ? { placement } : {}) });
+      setView(previous => ({ ...next, profileEnabled: previous?.profileEnabled }));
+      setNotice(zh ? '本片品牌设置已保存。' : 'Project brand settings saved.');
+    } catch { setNotice(zh ? '无法保存本片品牌，请确认项目已保存。' : 'Could not save the project brand. Check that the film is saved.'); }
+    finally { setBusy(false); }
+  }
+  async function editLogo(action: 'apply' | 'remove') {
+    if (busy) return;
+    setBusy(true); setNotice('');
+    try {
+      const result = await request<{ logoPlaced: boolean; errorCode?: string }>('brand:project-logo', { projectId, action });
+      if (result.errorCode) throw new Error(result.errorCode);
+      setView(previous => previous ? { ...previous, logoPlaced: result.logoPlaced } : previous);
+      setNotice(action === 'apply' ? (zh ? 'Logo 已放入时间轴，可独立编辑。' : 'Logo is on the timeline. You can edit it separately.') : (zh ? '已从时间轴移除 Logo。' : 'Logo removed from the timeline.'));
+    } catch (error) {
+      const message = error instanceof Error ? error.message : '';
+      setNotice(message === 'BRAND_LOGO_NEEDS_PICTURE' ? (zh ? '请先在时间轴上放一个有时长的画面。' : 'Add a visual clip with a known duration first.')
+        : message === 'BRAND_LOGO_LOCKED' ? (zh ? 'Logo 轨道已锁定，解锁后再试。' : 'Unlock the logo track and try again.')
+        : (zh ? '没有改动时间轴。请保存当前剪辑后重试。' : 'Timeline unchanged. Save the current edit and try again.'));
+    } finally { setBusy(false); }
+  }
+  return <div className="border-t border-[var(--border)] py-3">
+    <button type="button" className={button} aria-expanded={open} aria-controls={panelId}
+      onClick={() => { setOpen(!open); setNotice(''); }}>{zh ? '管理本片品牌' : 'Manage this film’s brand'}</button>
+    {open ? <section id={panelId} aria-label={zh ? '本片品牌' : 'Project brand'} className="max-h-[46vh] space-y-2 overflow-y-auto py-2 text-sm">
+      <p className="text-xs text-[var(--text-muted)]">{view?.brand ? (view.brand.name || (zh ? '本片使用品牌' : 'Brand enabled for this film')) : (zh ? '未给这部影片应用品牌。' : 'No brand applied to this film.')}</p>
+      <div className="flex flex-wrap items-center gap-2">
+        {view?.profileEnabled ? <button type="button" className={button} disabled={busy} onClick={() => void apply('snapshot')}>{view.brand ? (zh ? '更新本片品牌' : 'Update project brand') : (zh ? '用于本片' : 'Use for this film')}</button> : null}
+        {view?.brand ? <button type="button" className={button} disabled={busy} onClick={() => void apply('off')}>{zh ? '停用本片品牌记忆' : 'Disable brand memory for this film'}</button> : null}
+      </div>
+      {view?.brand ? <label className="flex items-center gap-2 text-xs"><span>{zh ? '本片 Logo 位置' : 'Project logo position'}</span>
+        <select className="rounded border border-[var(--border)] bg-[var(--bg-field)] px-2 py-1" value={view.brand.placement} disabled={busy} onChange={event => void apply('placement', event.target.value as Corner)}><PositionOptions zh={zh} /></select>
+      </label> : null}
+      {view?.brand?.logo || view?.logoPlaced ? <div className="flex flex-wrap items-center gap-2 border-t border-[var(--border)] pt-2">
+        {view.brand?.logo ? <button type="button" className={button} disabled={busy} onClick={() => void editLogo('apply')}>{view.logoPlaced ? (zh ? '更新影片中的 Logo' : 'Update logo on timeline') : (zh ? '把 Logo 放入影片' : 'Place logo on timeline')}</button> : null}
+        {view.logoPlaced ? <button type="button" className={button} disabled={busy} onClick={() => void editLogo('remove')}>{zh ? '从影片移除 Logo' : 'Remove logo from timeline'}</button> : null}
+      </div> : null}
+      {notice ? <p role="status" className="text-xs text-[var(--text-muted)]">{notice}</p> : null}
+    </section> : null}
+  </div>;
+}
