+                  aria-label="日志保留天数"
+                  value={stats?.retentionDays ?? 14}
+                  onChange={(e) => void handleRetentionChange(Number(e.target.value))}
+                  className="rounded border border-[var(--border)] bg-[var(--bg-panel)] px-1.5 py-0.5 text-[11px] text-[var(--text)]"
+                >
+                  <option value={7}>7 天</option>
+                  <option value={14}>14 天</option>
+                  <option value={30}>30 天</option>
+                  <option value={90}>90 天</option>
+                </select>
+              </label>
+            </div>
+          </div>
+
+          <div className="flex flex-wrap items-center gap-1.5">
+            {(
+              [
+                { id: 'all', label: `全部 (${total})` },
+                { id: 'error', label: '仅错误' },
+                { id: 'warn+', label: '警告+错误' },
+              ] as const
