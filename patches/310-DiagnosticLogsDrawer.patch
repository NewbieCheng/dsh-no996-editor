+                            type="button"
+                            onClick={() => { setSearch(entry.traceId || ''); void load(entry.traceId || ''); }}
+                            className="underline underline-offset-2 hover:text-[var(--text)]"
+                          >
+                            按 TraceID 追踪同链路 ({entry.traceId})
+                          </button>
+                        ) : null}
+                        {entry.durationMs != null ? <span>耗时: {entry.durationMs} ms</span> : null}
+                        {entry.projectId ? <span>项目: {entry.projectId}</span> : null}
+                        {entry.sessionDigest ? <span>会话摘要: {entry.sessionDigest}</span> : null}
+                      </div>
+                      {entry.detail ? (
+                        <pre className="max-h-56 overflow-auto rounded-md border border-[var(--border)] bg-[var(--bg-field)] p-2 font-mono text-[11px] leading-relaxed text-[var(--text)] whitespace-pre-wrap break-all">
+                          {JSON.stringify(entry.detail, null, 2)}
+                        </pre>
+                      ) : null}
+                    </div>
+                  ) : null}
+                </div>
+              );
+            })
+          )}
+
+          {manualText ? (
+            <div className="space-y-1 pt-2">
+              <div className="text-[11px] text-[var(--text-muted)]">手动复制框：</div>
+              <textarea
+                readOnly
+                rows={8}
+                value={manualText}
+                onFocus={(e) => e.currentTarget.select()}
+                className="w-full rounded-md border border-[var(--border)] bg-[var(--bg-field)] p-2 font-mono text-[11px] text-[var(--text)]"
+              />
+            </div>
+          ) : null}
+        </div>
+
+        <footer className="flex shrink-0 flex-wrap items-center justify-between gap-2 border-t border-[var(--border)] px-4 py-2.5">
+          <div className="flex flex-wrap items-center gap-1.5">
+            <button
+              type="button"
+              onClick={() => void handleCopyForDev()}
+              className="flex items-center gap-1.5 rounded-md border border-[var(--border-strong)] bg-[var(--bg-field)] px-2.5 py-1.5 text-[12px] font-medium text-[var(--text)] hover:bg-[var(--bg-hover)]"
+            >
+              <Copy size={13} />
+              <span>复制给开发者</span>
+            </button>
+            <button
+              type="button"
+              onClick={() => void handleAskAgent('chat')}
+              className="flex items-center gap-1.5 rounded-md border border-[var(--border-strong)] bg-[var(--bg-field)] px-2.5 py-1.5 text-[12px] font-medium text-[var(--text)] hover:bg-[var(--bg-hover)]"
+            >
+              <Sparkles size={13} />
+              <span>填入当前对话问 Agent</span>
+            </button>
+            <button
+              type="button"
+              onClick={() => void handleAskAgent('copy')}
+              className="flex items-center gap-1.5 rounded-md border border-[var(--border)] px-2.5 py-1.5 text-[12px] text-[var(--text-muted)] hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
+            >
+              <Bot size={13} />
+              <span>复制 Agent 提示词</span>
+            </button>
+            <button
+              type="button"
+              onClick={() => void handleExport()}
+              className="flex items-center gap-1.5 rounded-md border border-[var(--border)] px-2.5 py-1.5 text-[12px] text-[var(--text-muted)] hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
+            >
+              <Download size={13} />
+              <span>导出诊断包</span>
+            </button>
+          </div>
+          <div className="flex items-center gap-1.5">
+            <button
+              type="button"
+              onClick={() => void handleClear('expired')}
+              className="rounded-md px-2 py-1.5 text-[11.5px] text-[var(--text-muted)] hover:bg-[var(--bg-hover)] hover:text-[var(--text)]"
+            >
+              清理过期
+            </button>
+            <button
+              type="button"
+              onClick={() => void handleClear('all')}
+              className="flex items-center gap-1 rounded-md px-2 py-1.5 text-[11.5px] text-red-400 hover:bg-red-950/35"
+            >
+              <Trash2 size={12} />
+              <span>清空</span>
+            </button>
+          </div>
+        </footer>
+      </aside>
+    </div>,
+    document.body,
+  );
+}
+
+/** Global single-instance host mounted at shell root so any page or red banner can open the drawer. */
+export function DiagnosticLogsHost() {
+  const [open, setOpen] = React.useState(false);
+  const [traceId, setTraceId] = React.useState('');
+
+  React.useEffect(() => {
+    const onOpen = (event: Event) => {
+      const next = (event as CustomEvent<{ traceId?: string }>).detail?.traceId || '';
+      setTraceId(next);
+      setOpen(true);
+    };
+    window.addEventListener('no996:open-diagnostics', onOpen);
+    return () => window.removeEventListener('no996:open-diagnostics', onOpen);
+  }, []);
+
+  return <DiagnosticLogsDrawer open={open} initialTraceId={traceId} onClose={() => setOpen(false)} />;
+}
