+          </div>
+        </div>
+
+        {notice ? (
+          <div className="flex items-center gap-2 border-b border-[var(--border)] bg-[var(--bg-hover)] px-4 py-1.5 text-[11.5px] text-[var(--text)]">
+            <Check size={13} className="shrink-0 text-emerald-400" />
