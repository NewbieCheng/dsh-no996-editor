+      const now = new Date();
+      const pad = (n: number) => String(n).padStart(2, '0');
+      const name = `no996-openfilm-diagnostics-${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}-${pad(now.getHours())}${pad(now.getMinutes())}.json`;
+      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json;charset=utf-8' });
+      const url = URL.createObjectURL(blob);
+      const a = document.createElement('a');
+      a.href = url;
+      a.download = name;
+      document.body.appendChild(a);
+      a.click();
+      a.remove();
+      URL.revokeObjectURL(url);
+      flashNotice(`已导出 ${name}`);
+    } catch (err) {
+      flashNotice(`导出失败: ${String((err as Error)?.message || err)}`);
+    }
+  };
+
+  const handleRetentionChange = async (days: number) => {
+    try {
+      const res = await diagRpc<{ retentionDays: number; stats: DiagStats }>('diag:prefs', { retentionDays: days });
+      if (res?.stats) setStats(res.stats);
+      flashNotice(`已设置自动保留 ${days} 天并清理过期日志`);
+      void load();
+    } catch (err) {
+      flashNotice(`设置失败: ${String((err as Error)?.message || err)}`);
+    }
+  };
+
+  const handleClear = async (mode: 'expired' | 'all') => {
+    try {
