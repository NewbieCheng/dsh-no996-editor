+      if (res?.stats) setStats(res.stats);
+      if (mode === 'all') {
+        const raw = (window as unknown as { __no996DiagBuffer?: unknown[] }).__no996DiagBuffer;
+        if (Array.isArray(raw)) raw.length = 0;
+        window.dispatchEvent(new CustomEvent('no996:diag-cleared'));
+      }
+      flashNotice(mode === 'all' ? '已清空全部诊断日志' : `已清理过期日志 (${res?.removedFiles ?? 0} 个文件)`);
+      void load();
+    } catch (err) {
+      flashNotice(`清理失败: ${String((err as Error)?.message || err)}`);
+    }
+  };
+
+  if (!open) return null;
+
+  return createPortal(
+    <div className="fixed inset-0 z-[10070]" role="presentation">
+      <button
+        type="button"
+        aria-label="关闭诊断日志"
+        className="absolute inset-0 bg-black/50"
+        onClick={onClose}
+      />
+      <aside
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="no996-diag-center-title"
+        className="absolute inset-y-0 right-0 flex w-[min(680px,96vw)] flex-col border-l border-[var(--border)] bg-[var(--bg-panel)] shadow-[-18px_0_48px_rgba(0,0,0,.4)]"
+      >
+        <header className="flex h-12 shrink-0 items-center gap-2 border-b border-[var(--border)] px-4">
+          <div className="min-w-0 flex-1">
+            <h2 id="no996-diag-center-title" className="truncate text-[14px] font-semibold text-[var(--text)]">
+              错误与诊断日志中心
+            </h2>
+          </div>
+          <button
+            type="button"
+            disabled={busy}
+            onClick={() => void load()}
+            className="flex h-7 items-center gap-1 rounded-md border border-[var(--border)] px-2 text-[11.5px] text-[var(--text-muted)] hover:bg-[var(--bg-hover)] hover:text-[var(--text)] disabled:opacity-45"
