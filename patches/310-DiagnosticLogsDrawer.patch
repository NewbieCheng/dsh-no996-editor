+      flashNotice('无法自动写入剪贴板，请在下方文本框手动全选复制');
+    }
+  };
+
+  const handleCopyForDev = async () => {
+    try {
+      const data = await diagRpc<DiagExportResponse>('diag:export', {
+        projectId: currentProjectIdFromUrl(),
+        level,
+        layer,
+        limit: 80,
+      });
+      await copyText(data.markdown || JSON.stringify(data, null, 2), '已复制开发者诊断报告');
+    } catch (err) {
+      const fallback = JSON.stringify({ error: String((err as Error)?.message || err), entries: items.slice(0, 30) }, null, 2);
+      await copyText(fallback, '已复制页面诊断快照');
+    }
+  };
+
+  const handleAskAgent = async (mode: 'chat' | 'copy') => {
