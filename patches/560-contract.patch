 }
+
+/**
+ * Picks between two versions of the same growing text (a live snapshot and the row it belongs to).
+ *
+ * A snapshot may be behind the row (deltas arrived while it was in flight) or ahead of it (a normal
+ * extension). What it must never do is get appended: {@link mergeStreamText} falls back to `cur + next`
+ * when neither string is a prefix of the other, which turns one out-of-order snapshot into a visibly
+ * duplicated paragraph. Both values describe the same attempt, so the longer one is always right.
+ */
+export function preferLonger(cur: string, next: string): string {
+  if (!cur) return next;
+  if (next.startsWith(cur)) return next;
+  if (cur.startsWith(next)) return cur;
+  return cur.length >= next.length ? cur : next;
+}
