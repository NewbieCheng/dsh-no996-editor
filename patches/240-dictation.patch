+/**
+ * Local microphone dictation helper (16 kHz mono Int16 PCM WAV, capped at 120 s / 16 MB).
+ *
+ * Strictly routes audio to Host's local SenseVoice recognizer via
+ * `openfilmNative.asr.transcribeDictation`, never uploading microphone audio to cloud endpoints.
+ */
+
+export const MAX_DICTATION_SECONDS = 120;
+export const TARGET_SAMPLE_RATE = 16_000;
+
+export function downsampleTo16k(samples: Float32Array, fromRate: number): Int16Array {
+  if (!fromRate || fromRate <= TARGET_SAMPLE_RATE) {
+    const out = new Int16Array(samples.length);
+    for (let i = 0; i < samples.length; i += 1) {
+      const s = Math.max(-1, Math.min(1, samples[i] ?? 0));
+      out[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+    }
+    return out;
+  }
+  const ratio = fromRate / TARGET_SAMPLE_RATE;
+  const targetLen = Math.max(1, Math.floor(samples.length / ratio));
+  const out = new Int16Array(targetLen);
+  for (let i = 0; i < targetLen; i += 1) {
+    const start = Math.floor(i * ratio);
+    const end = Math.min(samples.length, Math.floor((i + 1) * ratio));
+    let sum = 0;
+    let count = 0;
+    for (let j = start; j < end; j += 1) {
+      sum += samples[j] ?? 0;
+      count += 1;
+    }
+    const avg = count > 0 ? sum / count : 0;
+    const clamped = Math.max(-1, Math.min(1, avg));
+    out[i] = clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff;
+  }
+  return out;
+}
+
+export function encodePcmWavBase64(pcm: Int16Array, sampleRate = TARGET_SAMPLE_RATE): string {
+  const dataBytes = pcm.byteLength;
+  const buf = new ArrayBuffer(44 + dataBytes);
+  const view = new DataView(buf);
+  const writeStr = (offset: number, s: string) => {
+    for (let i = 0; i < s.length; i += 1) view.setUint8(offset + i, s.charCodeAt(i));
+  };
+  writeStr(0, 'RIFF');
+  view.setUint32(4, 36 + dataBytes, true);
+  writeStr(8, 'WAVE');
+  writeStr(12, 'fmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, 1, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * 2, true);
+  view.setUint16(32, 2, true);
+  view.setUint16(34, 16, true);
+  writeStr(36, 'data');
+  view.setUint32(40, dataBytes, true);
+  new Int16Array(buf, 44).set(pcm);
+
+  const bytes = new Uint8Array(buf);
+  let binary = '';
+  const chunk = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunk) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
+  }
+  return btoa(binary);
+}
+
+export interface DictationRecorder {
+  stop: () => Promise<{ audioBase64: string; durationMs: number; rms: number }>;
+  abort: () => void;
+}
+
+export type MicFailure = 'micPolicy' | 'micDenied' | 'micMissing' | 'micUnavailable' | 'micUnsupported';
+
+export class MicRecorderError extends Error {
+  constructor(readonly reason: MicFailure) { super(reason); }
+}
+
+export async function startMicRecorder(onLimit?: () => void): Promise<DictationRecorder> {
+  const doc = document as Document & {
+    permissionsPolicy?: { allowsFeature: (feature: string) => boolean };
+    featurePolicy?: { allowsFeature: (feature: string) => boolean };
+  };
+  if ((doc.permissionsPolicy ?? doc.featurePolicy)?.allowsFeature('microphone') === false) {
+    throw new MicRecorderError('micPolicy');
+  }
+  if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
+    throw new MicRecorderError('micUnsupported');
+  }
+  let stream: MediaStream;
+  try {
+    stream = await navigator.mediaDevices.getUserMedia({
+      audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true },
+    });
+  } catch (error) {
+    const name = error instanceof Error ? error.name : '';
+    throw new MicRecorderError(name === 'NotAllowedError' || name === 'SecurityError' ? 'micDenied'
+      : name === 'NotFoundError' ? 'micMissing' : 'micUnavailable');
+  }
+  const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
+  let context: AudioContext | undefined;
+  let source: MediaStreamAudioSourceNode;
+  let processor: ScriptProcessorNode;
+  try {
+    context = new AudioCtx();
+    source = context.createMediaStreamSource(stream);
+    processor = context.createScriptProcessor(4096, 1, 1);
+    source.connect(processor);
+    processor.connect(context.destination);
+  } catch {
+    for (const track of stream.getTracks()) track.stop();
+    void context?.close().catch(() => {});
+    throw new MicRecorderError('micUnavailable');
+  }
+  const ctx = context;
+  const chunks: Float32Array[] = [];
+  let totalSamples = 0;
+  let stopped = false;
+  const startedAt = Date.now();
+  const maxSamples = Math.round(ctx.sampleRate * MAX_DICTATION_SECONDS);
+
+  const cleanup = () => {
+    try { processor.disconnect(); } catch { /* ignore */ }
+    try { source.disconnect(); } catch { /* ignore */ }
+    for (const track of stream.getTracks()) {
+      try { track.stop(); } catch { /* ignore */ }
+    }
+    void ctx.close().catch(() => {});
+  };
+
+  processor.onaudioprocess = (event) => {
+    if (stopped) return;
+    const input = event.inputBuffer.getChannelData(0);
+    chunks.push(new Float32Array(input));
+    totalSamples += input.length;
+    if (totalSamples >= maxSamples) {
+      stopped = true;
+      onLimit?.();
+    }
+  };
+  return {
+    abort() {
+      stopped = true;
+      cleanup();
+    },
+    async stop() {
+      stopped = true;
+      const sampleRate = ctx.sampleRate || 48_000;
+      const durationMs = Date.now() - startedAt;
+      cleanup();
+      const merged = new Float32Array(totalSamples);
+      let offset = 0;
+      let sumSq = 0;
+      for (const part of chunks) {
+        merged.set(part, offset);
+        for (let i = 0; i < part.length; i += 1) sumSq += (part[i] ?? 0) * (part[i] ?? 0);
+        offset += part.length;
+      }
+      const rms = totalSamples > 0 ? Math.sqrt(sumSq / totalSamples) : 0;
+      const pcm = downsampleTo16k(merged, sampleRate);
+      return {
+        audioBase64: encodePcmWavBase64(pcm, TARGET_SAMPLE_RATE),
+        durationMs,
+        rms,
+      };
+    },
+  };
+}
