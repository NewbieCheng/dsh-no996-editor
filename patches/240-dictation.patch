+/**
+ * Local microphone dictation helper (16 kHz mono Int16 PCM WAV, capped at 120 s / 16 MB).
+ *
+ * Strictly routes audio to Host's local SenseVoice recognizer via
+ * `openfilmNative.asr.transcribeDictation`, never uploading microphone audio to cloud endpoints.
+ */
+
+export const MAX_DICTATION_SECONDS = 120;
+export const TARGET_SAMPLE_RATE = 16_000;
+
+export function downsampleTo16k(samples: Float32Array, fromRate: number): Int16Array {
+  if (!fromRate || fromRate <= TARGET_SAMPLE_RATE) {
+    const out = new Int16Array(samples.length);
+    for (let i = 0; i < samples.length; i += 1) {
+      const s = Math.max(-1, Math.min(1, samples[i] ?? 0));
+      out[i] = s < 0 ? s * 0x8000 : s * 0x7fff;
+    }
+    return out;
+  }
+  const ratio = fromRate / TARGET_SAMPLE_RATE;
+  const targetLen = Math.max(1, Math.floor(samples.length / ratio));
+  const out = new Int16Array(targetLen);
+  for (let i = 0; i < targetLen; i += 1) {
+    const start = Math.floor(i * ratio);
+    const end = Math.min(samples.length, Math.floor((i + 1) * ratio));
+    let sum = 0;
+    let count = 0;
+    for (let j = start; j < end; j += 1) {
+      sum += samples[j] ?? 0;
+      count += 1;
+    }
+    const avg = count > 0 ? sum / count : 0;
+    const clamped = Math.max(-1, Math.min(1, avg));
+    out[i] = clamped < 0 ? clamped * 0x8000 : clamped * 0x7fff;
+  }
+  return out;
+}
+
+export function encodePcmWavBase64(pcm: Int16Array, sampleRate = TARGET_SAMPLE_RATE): string {
+  const dataBytes = pcm.byteLength;
+  const buf = new ArrayBuffer(44 + dataBytes);
+  const view = new DataView(buf);
+  const writeStr = (offset: number, s: string) => {
+    for (let i = 0; i < s.length; i += 1) view.setUint8(offset + i, s.charCodeAt(i));
+  };
+  writeStr(0, 'RIFF');
+  view.setUint32(4, 36 + dataBytes, true);
+  writeStr(8, 'WAVE');
+  writeStr(12, 'fmt ');
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true);
+  view.setUint16(22, 1, true);
+  view.setUint32(24, sampleRate, true);
+  view.setUint32(28, sampleRate * 2, true);
+  view.setUint16(32, 2, true);
+  view.setUint16(34, 16, true);
+  writeStr(36, 'data');
+  view.setUint32(40, dataBytes, true);
+  new Int16Array(buf, 44).set(pcm);
+
+  const bytes = new Uint8Array(buf);
+  let binary = '';
+  const chunk = 0x8000;
+  for (let i = 0; i < bytes.length; i += chunk) {
+    binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
+  }
+  return btoa(binary);
+}
+
+export interface DictationRecorder {
+  stop: () => Promise<{ audioBase64: string; durationMs: number; rms: number }>;
+  abort: () => void;
+}
+
+export type MicFailure = 'micPolicy' | 'micDenied' | 'micMissing' | 'micUnavailable' | 'micUnsupported';
+
+export class MicRecorderError extends Error {
+  constructor(readonly reason: MicFailure) { super(reason); }
+}
+
+/* ---------------------------------------------------------------------------
+ * Capture delegated to the DSH main frame.
+ *
+ * The embedded frame is a cross-origin subframe, and DSH's desktop microphone
+ * policy grants media only to the primary window's main frame, so this frame's
+ * own getUserMedia is refused without a prompt on every platform (`micDenied`
+ * with nowhere to allow it). The panel that hosts this frame records on our
+ * behalf — there the policy grants audio — and hands the finished 16 kHz WAV
+ * back over the validated postMessage bridge. Control messages (start/stop/
+ * abort, an id) are all this frame sends; the audio itself only flows from the
+ * panel back to this exact frame. When no capture host answers (older plugin
+ * build, standalone shell), the frame falls back to its own recorder below.
+ * ------------------------------------------------------------------------- */
+
+const CAPTURE_REQUEST = 'no996-openfilm:dictation-capture';
+const CAPTURE_AUDIO = 'no996-openfilm:dictation-audio';
+const KNOWN_REASONS: ReadonlySet<string> = new Set(['micPolicy', 'micDenied', 'micMissing', 'micUnavailable', 'micUnsupported']);
+
+/** The capture host answered and refused: its reason is the honest one to show. */
+export class ParentCaptureRefused extends MicRecorderError {
+  constructor(reason: MicFailure) { super(reason); }
+}
+
+/** No capture host replied in time: the caller may capture by itself. */
+export class ParentCaptureMissing extends Error {}
+
+interface CaptureAudio {
+  type: string;
+  version: number;
+  id: string;
+  ok: boolean;
+  phase?: string;
+  audioBase64?: string;
+  durationMs?: number;
+  rms?: number;
+  reason?: string;
+}
+
+interface Clip { audioBase64: string; durationMs: number; rms: number }
+
+const reasonOf = (data: CaptureAudio): MicFailure => {
+  const value = typeof data.reason === 'string' ? data.reason : '';
+  return (KNOWN_REASONS.has(value) ? value : 'micUnavailable') as MicFailure;
+};
+
+export function startParentRecorder(onLimit?: () => void, timeoutMs = 2000): Promise<DictationRecorder> {
+  const parent = window.parent;
+  if (parent === window) return Promise.reject(new ParentCaptureMissing());
+  const id = `dc-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`;
+  return new Promise((resolve, reject) => {
+    let recorderDone = false; // the outer promise settled (recorder handed out or refused)
+    let finalResolve: ((clip: Clip) => void) | null = null;
+    let finalReject: ((error: unknown) => void) | null = null;
+    let early: Clip | null = null;
+    let stopTimer = 0;
+    const cleanup = () => {
+      window.clearTimeout(timer);
+      window.clearTimeout(stopTimer);
+      window.removeEventListener('message', onMessage);
+    };
+    const timer = window.setTimeout(() => {
+      if (recorderDone) return;
+      recorderDone = true;
+      cleanup();
+      reject(new ParentCaptureMissing());
+    }, timeoutMs);
+    const onMessage = (event: MessageEvent) => {
+      if (event.source !== parent) return;
+      const data = event.data as CaptureAudio | null;
+      if (!data || typeof data !== 'object' || data.type !== CAPTURE_AUDIO || data.id !== id) return;
+      if (data.phase === 'started' && data.ok === true) {
+        recorderDone = true;
+        window.clearTimeout(timer);
+        resolve({
+          stop: () => new Promise<Clip>((res, rej) => {
+            if (early) { res(early); return; }
+            finalResolve = res;
+            finalReject = rej;
+            window.clearTimeout(stopTimer);
+            stopTimer = window.setTimeout(() => {
+              if (!finalReject) return;
+              const fail = finalReject;
+              finalReject = null;
+              fail(new MicRecorderError('micUnavailable'));
+            }, 5000);
+            parent.postMessage({ type: CAPTURE_REQUEST, version: 1, action: 'stop', id }, '*');
+          }),
+          abort: () => {
+            recorderDone = true;
+            cleanup();
+            parent.postMessage({ type: CAPTURE_REQUEST, version: 1, action: 'abort', id }, '*');
+          },
+        });
+        return;
+      }
+      // Any other reply with our id is an explicit answer: a started-phase
+      // refusal names why capture cannot begin; a later one rejects a stop that
+      // is already pending.
+      if (data.ok === true && typeof data.audioBase64 === 'string') {
+        const clip: Clip = { audioBase64: data.audioBase64, durationMs: Number(data.durationMs) || 0, rms: Number(data.rms) || 0 };
+        cleanup();
+        if (finalResolve) { const done = finalResolve; finalResolve = null; done(clip); }
+        else if (!early) { early = clip; onLimit?.(); } // the 120 s cap finished the clip by itself
+        return;
+      }
+      const reason = reasonOf(data);
+      cleanup();
+      if (finalReject) {
+        const fail = finalReject;
+        finalReject = null;
+        fail(new MicRecorderError(reason));
+      } else if (!recorderDone) {
+        recorderDone = true;
+        reject(new ParentCaptureRefused(reason));
+      }
+      // else: the recorder is out and nobody is waiting — nothing to answer.
+    };
+    window.addEventListener('message', onMessage);
+    parent.postMessage({ type: CAPTURE_REQUEST, version: 1, action: 'start', id }, '*');
+  });
+}
+
+export async function startMicRecorder(onLimit?: () => void): Promise<DictationRecorder> {
+  const doc = document as Document & {
+    permissionsPolicy?: { allowsFeature: (feature: string) => boolean };
+    featurePolicy?: { allowsFeature: (feature: string) => boolean };
+  };
+  if ((doc.permissionsPolicy ?? doc.featurePolicy)?.allowsFeature('microphone') === false) {
+    throw new MicRecorderError('micPolicy');
+  }
+  if (!window.isSecureContext || !navigator.mediaDevices?.getUserMedia) {
+    throw new MicRecorderError('micUnsupported');
+  }
+  let stream: MediaStream;
+  try {
+    stream = await navigator.mediaDevices.getUserMedia({
+      audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true },
+    });
+  } catch (error) {
+    const name = error instanceof Error ? error.name : '';
+    throw new MicRecorderError(name === 'NotAllowedError' || name === 'SecurityError' ? 'micDenied'
+      : name === 'NotFoundError' ? 'micMissing' : 'micUnavailable');
+  }
+  const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
+  let context: AudioContext | undefined;
+  let source: MediaStreamAudioSourceNode;
+  let processor: ScriptProcessorNode;
+  try {
+    context = new AudioCtx();
+    source = context.createMediaStreamSource(stream);
+    processor = context.createScriptProcessor(4096, 1, 1);
+    source.connect(processor);
+    processor.connect(context.destination);
+  } catch {
+    for (const track of stream.getTracks()) track.stop();
+    void context?.close().catch(() => {});
+    throw new MicRecorderError('micUnavailable');
+  }
+  const ctx = context;
+  const chunks: Float32Array[] = [];
+  let totalSamples = 0;
+  let stopped = false;
+  const startedAt = Date.now();
+  const maxSamples = Math.round(ctx.sampleRate * MAX_DICTATION_SECONDS);
+
+  const cleanup = () => {
+    try { processor.disconnect(); } catch { /* ignore */ }
+    try { source.disconnect(); } catch { /* ignore */ }
+    for (const track of stream.getTracks()) {
+      try { track.stop(); } catch { /* ignore */ }
+    }
+    void ctx.close().catch(() => {});
+  };
+
+  processor.onaudioprocess = (event) => {
+    if (stopped) return;
+    const input = event.inputBuffer.getChannelData(0);
+    chunks.push(new Float32Array(input));
+    totalSamples += input.length;
+    if (totalSamples >= maxSamples) {
+      stopped = true;
+      onLimit?.();
+    }
+  };
+  return {
+    abort() {
+      stopped = true;
+      cleanup();
+    },
+    async stop() {
+      stopped = true;
+      const sampleRate = ctx.sampleRate || 48_000;
+      const durationMs = Date.now() - startedAt;
+      cleanup();
+      const merged = new Float32Array(totalSamples);
+      let offset = 0;
+      let sumSq = 0;
+      for (const part of chunks) {
+        merged.set(part, offset);
+        for (let i = 0; i < part.length; i += 1) sumSq += (part[i] ?? 0) * (part[i] ?? 0);
+        offset += part.length;
+      }
+      const rms = totalSamples > 0 ? Math.sqrt(sumSq / totalSamples) : 0;
+      const pcm = downsampleTo16k(merged, sampleRate);
+      return {
+        audioBase64: encodePcmWavBase64(pcm, TARGET_SAMPLE_RATE),
+        durationMs,
+        rms,
+      };
+    },
+  };
+}
