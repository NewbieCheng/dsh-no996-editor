+.nof-lg .lg-punch time{flex:none;font:700 28px/1 "Noto Sans SC",sans-serif;font-variant-numeric:tabular-nums;color:var(--sun)}
+.nof-lg .lg-card h1{margin:0;font:400 36px/1.2 "Ma Shan Zheng","STKaiti","KaiTi",serif;letter-spacing:.04em}
+.nof-lg .lg-sub{margin:4px 0 10px;color:var(--mute);font-size:14px}
+.nof-lg .lg-field{display:block;margin-top:14px;color:var(--mute);font-size:14px}
+.nof-lg .lg-lab{display:block;margin-bottom:2px}
+.nof-lg .lg-f{position:relative;display:block;border-bottom:1.5px solid var(--line)}
+.nof-lg .lg-f::after{content:"";position:absolute;left:0;bottom:-1.5px;height:3px;width:100%;background:var(--sun);transform:scaleX(0);transform-origin:left;transition:transform .3s}
+.nof-lg .lg-f:focus-within::after{transform:scaleX(1)}
+.nof-lg .lg-f input{width:100%;padding:8px 56px 8px 2px;border:0;background:none;font:500 17px/1.4 "Noto Sans SC",sans-serif;color:var(--ink);outline:none}
+.nof-lg .lg-f input::placeholder{color:#a79d8a;font-weight:400}
+.nof-lg .lg-eye{position:absolute;right:0;top:6px;border:0;background:none;color:var(--mute);font:400 13px "Noto Sans SC",sans-serif;cursor:pointer;padding:4px 2px}
+.nof-lg .lg-eye:focus-visible,.nof-lg .lg-go:focus-visible,.nof-lg .lg-lk:focus-visible,.nof-lg .lg-tracks:focus-visible,.nof-lg .lg-play:focus-visible,.nof-lg .lg-remember input:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
+.nof-lg .lg-meta{display:flex;align-items:center;justify-content:space-between;gap:10px 16px;margin-top:14px;flex-wrap:wrap}
+.nof-lg .lg-remember{display:inline-flex;align-items:center;gap:7px;margin:0;color:var(--mute);font:400 13px/1.3 "Noto Sans SC",sans-serif;cursor:pointer;user-select:none;min-width:0}
+.nof-lg .lg-remember input{width:14px;height:14px;margin:0;accent-color:var(--sun);cursor:pointer;flex:none}
+.nof-lg .lg-remember span{white-space:nowrap}
+.nof-lg .lg-remember[hidden]{display:none!important}
+.nof-lg .lg-go{display:block;width:100%;margin-top:18px;padding:14px;border:0;border-radius:3px;background:var(--ink);color:#fff;font:700 17px "Noto Sans SC",sans-serif;letter-spacing:.08em;box-shadow:0 4px 0 var(--sun);cursor:pointer;transition:transform .15s,box-shadow .15s}
+.nof-lg .lg-go:hover{transform:translateY(-1px);box-shadow:0 5px 0 var(--sun)}
+.nof-lg .lg-go:active{transform:translateY(3px);box-shadow:0 1px 0 var(--sun)}
+.nof-lg .lg-go:disabled{opacity:.6;cursor:default;transform:none}
+/* Secondary: local guest session when the workbench account service is unreachable. */
+.nof-lg .lg-go-guest{display:block;width:100%;margin-top:10px;padding:12px;border:1.5px solid color-mix(in srgb,var(--ink) 28%,transparent);border-radius:3px;background:transparent;color:var(--ink);font:650 14px/1.2 "Noto Sans SC",sans-serif;letter-spacing:.04em;cursor:pointer;transition:background .15s,border-color .15s}
+.nof-lg .lg-go-guest:hover{background:color-mix(in srgb,var(--ink) 6%,transparent);border-color:color-mix(in srgb,var(--ink) 45%,transparent)}
+.nof-lg .lg-go-guest:disabled{opacity:.55;cursor:default}
+.nof-lg .lg-go-guest:focus-visible{outline:3px solid var(--sun);outline-offset:3px}
+.nof-lg .lg-links{display:inline-flex;align-items:center;gap:0;margin:0 0 0 auto;flex:none}
+.nof-lg .lg-lk{border:0;background:none;padding:0;color:#d84700;font:400 13px/1.3 "Noto Sans SC",sans-serif;text-decoration:none;border-bottom:1px solid rgba(216,71,0,.4);cursor:pointer;white-space:nowrap}
+.nof-lg .lg-lk+.lg-lk{margin-left:10px;padding-left:10px;border-left:1px solid var(--line)}
+@media (max-width:420px){.nof-lg .lg-remember span{white-space:normal}.nof-lg .lg-meta{align-items:flex-start}}
+.nof-lg .lg-msg{margin:12px 0 0;min-height:1.6em;color:var(--mute);font-size:13.5px}
+.nof-lg .lg-msg.err{color:#c23a00;font-weight:500}
+.nof-lg .lg-stamp{position:absolute;right:26px;top:70px;width:92px;height:92px;border:3px double #d84700;border-radius:50%;display:grid;place-items:center;color:#d84700;font:400 25px/1.1 "Ma Shan Zheng","STKaiti",serif;text-align:center;transform:rotate(-14deg) scale(1.9);opacity:0;pointer-events:none;mix-blend-mode:multiply}
+.nof-lg .lg-done .lg-stamp{opacity:.88;transform:rotate(-14deg) scale(1);transition:transform .35s cubic-bezier(.5,0,.2,1.4),opacity .2s}
+.nof-lg .lg-row{display:flex;gap:10px;align-items:flex-end}
+.nof-lg .lg-row .lg-field{flex:1;min-width:0}
+.nof-lg .lg-otp{flex:none;margin-bottom:2px;border:1px solid var(--line);background:rgba(255,255,255,.4);color:var(--ink);font:400 13px "Noto Sans SC",sans-serif;padding:8px 10px;border-radius:3px;cursor:pointer}
+.nof-lg .lg-otp:disabled{opacity:.55;cursor:default}
+.nof-lg .lg-tl{position:fixed;left:0;right:0;bottom:0;z-index:3;padding:28px 18px calc(16px + env(safe-area-inset-bottom,0px));background:linear-gradient(180deg,transparent 0%,rgba(3,10,27,.55) 28%,rgba(3,10,27,.92) 100%)}
+.nof-lg .lg-ruler{position:relative;height:18px;margin:0 4px 6px;font-size:10px;color:rgba(180,198,230,.85);font-variant-numeric:tabular-nums;letter-spacing:.02em}
+.nof-lg .lg-ruler i{position:absolute;bottom:0;height:8px;padding-left:3px;border-left:1px solid rgba(159,176,208,.45);font-style:normal;line-height:1}
+.nof-lg .lg-ruler i b{position:absolute;bottom:10px;left:-1px;font-weight:500;transform:translateX(-50%);text-shadow:0 1px 6px rgba(0,0,0,.45)}
+.nof-lg .lg-tracks{position:relative;display:flex;height:72px;cursor:ew-resize;touch-action:none;user-select:none;-webkit-user-select:none;border-radius:10px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.08),0 10px 28px rgba(0,0,0,.28);overflow:hidden}
+.nof-lg .lg-tracks.drag{cursor:grabbing}
+.nof-lg .lg-clips{display:flex;flex:1;min-width:0}
+.nof-lg .lg-clip{position:relative;overflow:hidden;min-width:0;border-top:2px solid #243a6d;border-left:1px solid rgba(5,12,30,.55);background:linear-gradient(180deg,#1a2f58,#101e42);padding:8px 10px;color:#9aafd4;font-size:12px;font-weight:500;white-space:nowrap;letter-spacing:.01em;transition:background .45s ease,color .45s ease,border-color .45s ease,box-shadow .45s ease}
+.nof-lg .lg-clip:first-child{border-left:0}
+.nof-lg .lg-clip.on{background:linear-gradient(180deg,#7a3418,#3a1d28);border-top-color:#FF6400;color:#ffd2a4;box-shadow:inset 0 -18px 24px rgba(255,100,0,.08)}
+.nof-lg .lg-playhead{position:absolute;top:-22px;bottom:0;left:0;width:0;z-index:2;pointer-events:none}
+.nof-lg .lg-playhead::before{content:"";position:absolute;left:-1px;top:18px;bottom:0;width:2px;background:#fff;box-shadow:0 0 14px rgba(255,255,255,.75)}
+.nof-lg .lg-grip{position:absolute;left:-11px;top:0;width:22px;height:22px;border-radius:7px;background:#fff;box-shadow:0 2px 10px rgba(0,0,0,.45)}
+.nof-lg .lg-grip::after{content:"";position:absolute;inset:6px;background:repeating-linear-gradient(90deg,var(--ink) 0 1.5px,transparent 1.5px 4px)}
+.nof-lg .lg-tip{position:absolute;bottom:calc(100% + 8px);left:50%;padding:4px 10px;border-radius:999px;background:rgba(5,15,38,.9);color:#fff;font:550 12px/1.4 "Noto Sans SC",sans-serif;white-space:nowrap;font-variant-numeric:tabular-nums;border:1px solid rgba(255,140,40,.55);box-shadow:0 6px 18px rgba(0,0,0,.35);transform:translateX(-50%)}
+.nof-lg .lg-play{position:absolute;right:18px;bottom:calc(100% + 10px);z-index:4;width:40px;height:40px;display:grid;place-items:center;border-radius:50%;border:1px solid rgba(255,255,255,.4);background:rgba(6,14,32,.82);color:#fff;cursor:pointer;box-shadow:0 8px 20px rgba(0,0,0,.35);transition:background .2s,border-color .2s,transform .15s}
+.nof-lg .lg-play:hover{background:rgba(255,106,0,.9);border-color:rgba(255,106,0,.9)}
+.nof-lg .lg-play svg{width:18px;height:18px;fill:currentColor;display:block}
+@media (max-width:520px){.nof-lg .lg-card{padding:22px 22px 18px}.nof-lg .lg-card h1{font-size:30px}.nof-lg .lg-stamp{width:76px;height:76px;font-size:21px;top:64px;right:16px}.nof-lg .lg-clip{padding:5px 3px;font-size:10.5px}.nof-lg .lg-tracks{height:62px}.nof-lg .lg-main{padding-bottom:calc(var(--tlh) + 80px)}}
+.nof-lg .cap-mask[hidden]{display:none!important}
