+/**
+ * no996-editor: push a model/thinking/permission selection straight to the
+ * currently attached live session so changes apply before a turn is sent.
+ */
+export async function applyLiveSessionOption(
+  agent: LocalAgentId,
+  configId: string,
+  value: unknown,
+  scope: { projectId: string; conversation: string },
+): Promise<LocalAgentSessionInfo['configOptions'] | null> {
+  const bridge = desktopBridge()?.localAgents;
+  if (!bridge?.setOption || !scope?.projectId || !scope.conversation) return null;
+  const preferredKey = `${scope.projectId}:${scope.conversation}:${agent}`;
+  if (preferredKey) {
+    const inflight = attaching.get(preferredKey);
+    if (inflight) await inflight.catch(() => null);
+  }
+  const target = sessions.get(preferredKey);
+  if (!target) return null;
+  const option = target.info.configOptions?.find(o => o.id === configId);
+  if (!option?.options?.some(o => o.value === value)) return null;
+  const res = await bridge.setOption(target.key, configId, value).catch(() => null);
+  const updated = res?.ok ? res.result?.configOptions : undefined;
+  if (Array.isArray(updated) && updated.length) {
+    target.info.configOptions = updated;
+    return updated;
+  }
+  return null;
 }
