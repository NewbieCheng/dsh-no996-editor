+/**
+ * no996-editor: bind the page key and read context usage + configOptions when a
+ * conversation is opened or switched — without waiting for the first prompt.
+ */
+export async function attachLocalAgentSession({
+  projectId,
+  conversation,
+  resume = null,
+  agent,
+  cwd,
+  meta,
+  onOptions,
+}: {
+  projectId: string;
+  conversation: string;
+  resume?: string | null;
+  agent: LocalAgentId;
+  cwd: string;
+  meta?: Record<string, unknown>;
+  onOptions?: (options: LocalAgentSessionInfo['configOptions']) => void;
+}): Promise<LocalAgentSessionInfo | null> {
+  const bridge = desktopBridge()?.localAgents;
+  if (!bridge) return null;
+  listen();
+  const sessionKey = `${projectId}:${conversation}:${agent}`;
+  lastAttachedSessionKey.set(agent, sessionKey);
+  const existing = sessions.get(sessionKey);
+  if (existing && existing.cwd === cwd) {
+    if (onOptions && existing.info.configOptions) onOptions(existing.info.configOptions);
+    tellContext();
+    return existing.info;
+  }
+  let pending = attaching.get(sessionKey);
+  if (!pending) {
+    pending = (async () => {
+      const started = await bridge.start(agent, cwd, resume, meta as LocalAgentTurnMeta | undefined);
+      if (!started.ok) return null;
+      const session: LiveSession = {
+        key: started.key,
+        agent,
+        cwd,
+        info: started.info,
+        projectId,
+        conversation,
+        needsHistoryCarryOver: Boolean(resume && (!started.info.resumed || started.info.sessionId !== resume)),
+      };
+      sessions.set(sessionKey, session);
+      const initialUsage = (started.info as LocalAgentSessionInfo & { usage?: { used?: unknown; size?: unknown } }).usage;
+      if (initialUsage && typeof initialUsage.used === 'number' && typeof initialUsage.size === 'number' && initialUsage.size > 0) {
+        contextByKey.set(started.key, { used: initialUsage.used, size: initialUsage.size });
+      }
+      const initialMode = (started.info as LocalAgentSessionInfo & { workMode?: unknown }).workMode;
+      if (initialMode && typeof initialMode === 'object') {
+        recordWorkMode(started.key, initialMode as Partial<WorkModeState>);
+      }
+      tellContext();
+      return session;
+    })().finally(() => {
+      if (attaching.get(sessionKey) === pending) attaching.delete(sessionKey);
+    });
+    attaching.set(sessionKey, pending);
+  }
+  const session = await pending;
+  if (!session) return null;
+  onOptions?.(session.info.configOptions);
+  return session.info;
+}
