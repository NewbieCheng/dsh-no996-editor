+function ProjectBrandSettings({ projectId, savedRevision }: { projectId: string; savedRevision: number }) {
+  const zh = isZh();
+  const [open, setOpen] = React.useState(false);
+  const [view, setView] = React.useState<ProjectBrand>();
+  const [notice, setNotice] = React.useState('');
+  const [busy, setBusy] = React.useState(false);
+  const panelId = React.useId();
+  React.useEffect(() => {
+    if (!open) return;
+    const task = new AbortController();
+    void request<ProjectBrand>('brand:project-get', { projectId }, task.signal).then(value => {
+      if (!task.signal.aborted) setView(value);
+    }).catch(() => { if (!task.signal.aborted) setNotice(zh ? '无法读取本片品牌。' : 'Project brand could not be loaded.'); });
+    return () => task.abort();
+  }, [open, projectId, savedRevision, zh]);
+
+  async function apply(mode: 'snapshot' | 'off' | 'placement', placement?: Corner) {
+    if (busy) return;
+    setBusy(true); setNotice('');
+    try {
+      const next = await request<ProjectBrand>('brand:project-set', { projectId, mode, ...(placement ? { placement } : {}) });
+      setView(previous => ({ ...next, profileEnabled: previous?.profileEnabled }));
+      setNotice(zh ? '本片品牌设置已保存。' : 'Project brand settings saved.');
+    } catch { setNotice(zh ? '无法保存本片品牌，请确认项目已保存。' : 'Could not save the project brand. Check that the film is saved.'); }
+    finally { setBusy(false); }
+  }
+  async function editLogo(action: 'apply' | 'remove') {
+    if (busy) return;
+    setBusy(true); setNotice('');
+    try {
+      const result = await request<{ logoPlaced: boolean; errorCode?: string }>('brand:project-logo', { projectId, action });
+      if (result.errorCode) throw new Error(result.errorCode);
+      setView(previous => previous ? { ...previous, logoPlaced: result.logoPlaced } : previous);
+      setNotice(action === 'apply' ? (zh ? 'Logo 已放入时间轴，可独立编辑。' : 'Logo is on the timeline. You can edit it separately.') : (zh ? '已从时间轴移除 Logo。' : 'Logo removed from the timeline.'));
+    } catch (error) {
+      const message = error instanceof Error ? error.message : '';
+      setNotice(message === 'BRAND_LOGO_NEEDS_PICTURE' ? (zh ? '请先在时间轴上放一个有时长的画面。' : 'Add a visual clip with a known duration first.')
+        : message === 'BRAND_LOGO_LOCKED' ? (zh ? 'Logo 轨道已锁定，解锁后再试。' : 'Unlock the logo track and try again.')
+        : (zh ? '没有改动时间轴。请保存当前剪辑后重试。' : 'Timeline unchanged. Save the current edit and try again.'));
+    } finally { setBusy(false); }
+  }
+  return <div className="py-2">
+    <button type="button" className={button} aria-expanded={open} aria-controls={panelId}
+      onClick={() => { setOpen(!open); setNotice(''); }}>{zh ? '管理本片品牌' : 'Manage this film’s brand'}</button>
+    {open ? <section id={panelId} aria-label={zh ? '本片品牌' : 'Project brand'} className="mt-2 space-y-2 overflow-y-auto text-sm">
+      <p className="text-xs text-[var(--text-muted)]">{view?.brand ? (view.brand.name || (zh ? '本片使用品牌' : 'Brand enabled for this film')) : (zh ? '未给这部影片应用品牌。' : 'No brand applied to this film.')}</p>
+      <div className="flex flex-wrap items-center gap-2">
+        {view?.profileEnabled ? <button type="button" className={button} disabled={busy} onClick={() => void apply('snapshot')}>{view.brand ? (zh ? '更新本片品牌' : 'Update project brand') : (zh ? '用于本片' : 'Use for this film')}</button> : null}
+        {view?.brand ? <button type="button" className={button} disabled={busy} onClick={() => void apply('off')}>{zh ? '停用本片品牌记忆' : 'Disable brand memory for this film'}</button> : null}
+      </div>
+      {view?.brand ? <label className="flex items-center gap-2 text-xs"><span>{zh ? '本片 Logo 位置' : 'Project logo position'}</span>
+        <select className="rounded border border-[var(--border)] bg-[var(--bg-field)] px-2 py-1" value={view.brand.placement} disabled={busy} onChange={event => void apply('placement', event.target.value as Corner)}><PositionOptions zh={zh} /></select>
+      </label> : null}
+      {view?.brand?.logo || (view?.brand?.display === 'logo-name' && view.brand.name) || view?.logoPlaced ? <div className="flex flex-wrap items-center gap-2 border-t border-[var(--border)] pt-2">
+        {view.brand?.logo || (view.brand?.display === 'logo-name' && view.brand.name) ? <button type="button" className={button} disabled={busy} onClick={() => void editLogo('apply')}>{view.logoPlaced ? (zh ? '更新影片中的 Logo' : 'Update logo on timeline') : (zh ? '把 Logo 放入影片' : 'Place logo on timeline')}</button> : null}
+        {view.logoPlaced ? <button type="button" className={button} disabled={busy} onClick={() => void editLogo('remove')}>{zh ? '从影片移除 Logo' : 'Remove logo from timeline'}</button> : null}
+      </div> : null}
+      {notice ? <p role="status" className="text-xs text-[var(--text-muted)]">{notice}</p> : null}
+    </section> : null}
+  </div>;
+}
