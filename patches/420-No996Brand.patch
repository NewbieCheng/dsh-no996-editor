+const setupChanged = 'no996:brand-setup-changed';
+export function No996BrandSetupHint() {
+  const zh = isZh();
+  const [show, setShow] = React.useState(false);
+  const [busy, setBusy] = React.useState(false);
+  const [error, setError] = React.useState(false);
+  React.useEffect(() => {
+    const task = new AbortController();
+    const done = () => { task.abort(); setShow(false); };
+    window.addEventListener(setupChanged, done);
+    void request<{ configured: boolean }>('brand:setup-status', {}, task.signal).then(result => {
+      if (!task.signal.aborted) setShow(!result.configured);
+    }).catch(() => {});
+    return () => { task.abort(); window.removeEventListener(setupChanged, done); };
+  }, []);
+  if (!show) return null;
+  return <aside aria-label={zh ? '开工提示' : 'Getting started'} className="mx-5 my-2 flex shrink-0 flex-wrap items-center gap-3 rounded-md border border-[var(--border)] px-3 py-2 text-sm">
+    <span className="font-medium">{zh ? '添加你的品牌 Logo' : 'Add your brand logo'}</span>
+    <span className="min-w-0 flex-1 text-xs text-[var(--text-muted)]">{error ? (zh ? '暂时无法保存，请重试。' : 'Could not save. Try again.') : (zh ? '先预览，再决定放不放进影片。' : 'Preview it before using it in a film.')}</span>
+    <button type="button" className={button} onClick={() => window.dispatchEvent(new CustomEvent('no996:navigate-settings', { detail: { section: 'assets' } }))}>{zh ? '去配置' : 'Set up brand'}</button>
+    <button type="button" className={button} disabled={busy} onClick={() => { setBusy(true); setError(false); void request('brand:setup-dismiss', {}).then(() => window.dispatchEvent(new Event(setupChanged)), () => setError(true)).finally(() => setBusy(false)); }}>{zh ? '暂不设置' : 'Skip for now'}</button>
+  </aside>;
+}
