+import { useLanguage, useT } from '@/i18n';
+import { PRODUCT_NAME, PRODUCT_NAME_ZH } from '../../../../../shared/src/no996-brand';
+
+type Wallet = {
+  available_points?: number | null;
+  points_balance?: number | null;
+  period_points_balance?: number | null;
+  expert_points_balance?: number | null;
+  period_expires_at?: string | null;
+  cached_at?: string;
+  stale?: boolean;
+  source?: string;
+  message?: string;
+};
+
+type AuthStatus = {
+  loggedIn: boolean;
+  dev?: boolean;
+  guest?: boolean;
+  account?: string;
+  displayName?: string;
+  credits?: number | null;
+  balance?: Wallet;
+};
+
+type CapabilitiesEndpoint = {
