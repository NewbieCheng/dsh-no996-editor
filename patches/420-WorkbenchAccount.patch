+/**
+ * Workbench account chip + User Center drawer (~480px) for 不加班.
+ * Covers:
+ *  - Hero identity & 3-bucket points wallet
+ *  - Tab 1: 账号概览与平台能力状态 (短效 Host JWT，无本地静态密钥)
+ *  - Tab 2: 我的积分扣费表 (/billing/traces & /account/ledgers，含 N 分钟合并标识)
+ *  - Tab 3: 可调模型与费率表 (/pricing/catalog & /v1 spec)
+ */
+import * as React from 'react';
+import { createPortal } from 'react-dom';
+import {
